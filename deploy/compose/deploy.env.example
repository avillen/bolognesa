# Copy to .env.deploy at the repository root. This is Make configuration,
# not the server runtime .env. Do not place application secrets here.
DEPLOY_TRANSPORT=local
DEPLOY_DIR=/srv/bolognesa
DOCKER_BIN=docker
DEPLOY_COMPOSE_FILES=compose.yaml
DEPLOY_HEALTH_URL=http://127.0.0.1:4000/
DEPLOY_MIN_FREE_KIB=262144
DEPLOY_BACKUP_KEEP=3

# Remote operation: set transport to ssh and configure these values.
DEPLOY_HOST=user@server.local
# Example alternatives:
# DEPLOY_COMPOSE_FILES=compose.yaml:network.host.yaml:storage.bind.yaml:media.local.yaml
# Optional Sonarr/Radarr/Prowlarr with a separately configured download client:
# Append :media-automation.yaml to your existing selection; see media-automation.md.

# Optional local build/export, followed by deploy-upload and deploy-update.
BUILD_DOCKER_BIN=docker
DEPLOY_IMAGE_NAME=bolognesa:lan
DEPLOY_IMAGE_TAR=
DEPLOY_BUILD_PLATFORM=

# Release defaults derive the registry namespace from the GitHub repository.
IMAGE_REPOSITORY=
DEPLOY_WORKFLOW=container-image.yml
DEPLOY_ARTIFACT=server-image-ref
DEPLOY_RUN_ID=

# Only for explicit adoption/change of an existing DB configuration:
ALLOW_DATABASE_CONFIG_CHANGE=no
EXPECTED_DATABASE_SOURCE=
