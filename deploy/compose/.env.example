# Use an immutable sha tag or digest for controlled updates.
BOLOGNESA_IMAGE=ghcr.io/avillen/bolognesa:latest-lan

# Generate both secrets locally; never commit them.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Private hostname or IP used to open Bolognesa in a browser.
PHX_HOST=192.0.2.1
PUBLIC_PORT=4000

# Host interface for private LAN/Tailscale access. Keep loopback unless needed.
BOLOGNESA_BIND_IP=127.0.0.1
BOLOGNESA_PORT=4000

# Host paths. MEDIA_PATH must already exist and be readable by Docker.
MEDIA_PATH=/srv/media

# Optional TMDb API read token.
TMDB_READ_TOKEN=

# Keep empty to validate the WebSocket origin against PHX_HOST.
# Set to "conn" only when multiple hostnames are intentionally used.
PHX_CHECK_ORIGIN=

# Optional settings. Defaults are budgets, not measured hardware requirements.
COMPOSE_PROJECT_NAME=bolognesa-server
BOLOGNESA_LIBRARY_ROOTS=/media
APP_MEMORY_LIMIT=1024m
APP_CPUS=2.0
DB_MEMORY_LIMIT=256m
DB_CPUS=1.0
TRANSCODE_TMPFS_SIZE=512m
POOL_SIZE=10
ERL_FLAGS=
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Used only with network.host.yaml or storage.bind.yaml.
DB_PORT=5432
POSTGRES_DATA_PATH=

# Used only with media.example.yaml or your own media override.
MOVIES_PATH=
SERIES_PATH=
