# Optional: append these settings to the target server's ignored .env only when
# selecting monitoring.yaml. Normal installations need none of these values.
# Generate the scrape token with: openssl rand -hex 32
BOLOGNESA_METRICS_TOKEN=

# Grafana Cloud > your stack > Prometheus > Send metrics / Details.
GRAFANA_CLOUD_METRICS_URL=https://prometheus.example.invalid/api/prom/push
GRAFANA_CLOUD_METRICS_USERNAME=
# Access policy token with metrics:write for this stack; not a dashboard API token.
GRAFANA_CLOUD_METRICS_TOKEN=

# Stable public-safe name; use a distinct name per installation sharing a stack.
BOLOGNESA_METRICS_INSTANCE=bolognesa
ALLOY_MEMORY_LIMIT=256m
ALLOY_CPUS=0.5

# Optional logs pipeline; required only when selecting monitoring.loki.yaml.
# Grafana Cloud > your stack > Loki > Details / Send logs.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod.example.invalid/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=
# Access policy token with logs:write for this stack; not a dashboard API token.
GRAFANA_CLOUD_LOKI_TOKEN=
BOLOGNESA_LOGS_INSTANCE=bolognesa
ALLOY_LOGS_MEMORY_LIMIT=128m
ALLOY_LOGS_CPUS=0.25
