<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
>
  <section id="music-screen" class="music-library" phx-hook="AudioPlayer">
    <p
      id="music-queue-feedback"
      role="status"
      aria-live="polite"
      class="text-sm text-muted"
      data-added={gettext("Añadida a la cola")}
      data-failed={gettext("No se pudo añadir a la cola")}
    >
    </p>
    <header class="music-header">
      <div>
        <p class="music-eyebrow">{gettext("Biblioteca local")}</p><h1 class="music-title">
          {@library_name || gettext("Música")}
        </h1>
      </div>
    </header>
    <BrowseControls.navigation
      browse_kind={@browse_kind}
      library_params={@library_params}
      artist_id={@artist_id}
    />
    <Home.home
      :if={@last_listened_visible?}
      albums={@recent_albums}
      status={@last_listened_status}
      library_params={@library_params}
      library_id={@active_library_id}
    />
    <DetailHeading.detail_heading
      :if={@browse_kind == :album || (@browse_kind == :albums && @artist_id)}
      browse_kind={@browse_kind}
      library_params={@library_params}
      artist_id={@artist_id}
      album_id={@album_id}
      active_library_id={@active_library_id}
      loading?={@loading?}
      heading={@heading}
      total={@total}
      error={@error}
    />
    <BrowseControls.search
      :if={@browse_kind != :home}
      form={@form}
    />
    <BrowseControls.feedback
      loading?={@loading?}
      error={@error}
      browse_kind={@browse_kind}
      total={@total}
    />
    <div
      id="music-browse"
      phx-update="stream"
      hidden={@browse_kind not in [:artists, :albums] || @loading? || @error != nil}
      class="music-browse-grid"
    >
      <BrowseCard.browse_card
        :for={{dom_id, item} <- @streams.groups}
        id={dom_id}
        item={item}
        browse_kind={@browse_kind}
        library_params={@library_params}
        browse_params={@browse_params}
      />
    </div>
    <div
      id="music-tracks"
      phx-update="stream"
      class="music-track-list"
      hidden={@browse_kind in [:home, :artists, :albums] || @loading? || @error != nil}
    >
      <TrackRow.track_row
        :for={{dom_id, track} <- @streams.tracks}
        id={dom_id}
        track={track}
        browse_kind={@browse_kind}
        album_id={@album_id}
        active_library_id={@active_library_id}
      />
    </div>
    <BrowseControls.pagination
      total={@total}
      page_size={@page_size}
      page={@page}
      browse_params={@browse_params}
      query={@query}
    />
  </section>
</Layouts.app>
