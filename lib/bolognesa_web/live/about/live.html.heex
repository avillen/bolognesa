<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:about}
>
  <section id="about-screen" class="mx-auto max-w-3xl space-y-8">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
        {gettext("Bolognesa")}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">{gettext("Acerca de")}</h1>
      <p class="mt-4 text-sm leading-6 text-muted">
        {gettext("Tu biblioteca personal de películas.")}
      </p>
    </header>
    <section
      id="tmdb-attribution"
      class="rounded-2xl border border-border bg-surface p-6 sm:p-8"
    >
      <h2 class="text-xl font-semibold text-ink">{gettext("Datos de películas")}</h2>
      <p class="mt-3 text-sm leading-6 text-muted">
        {gettext(
          "Los metadatos de películas se obtienen de TMDB cuando la identificación está configurada."
        )}
      </p>
      <a
        href="https://www.themoviedb.org"
        target="_blank"
        rel="noopener noreferrer"
        class={button_variant(%{variant: "outline"}, "mt-6 gap-4 py-3")}
      >
        <img
          src={~p"/images/tmdb-logo.svg"}
          alt={gettext("Logotipo de TMDB")}
          width="93"
          height="67"
          class="h-auto w-20"
        />
        <span class="font-medium">{gettext("Visitar TMDB")}</span>
      </a>
      <p class="mt-6 text-sm leading-6 text-muted">
        {gettext("This product uses the TMDB API but is not endorsed or certified by TMDB.")}
      </p>
    </section>
  </section>
</Layouts.app>
