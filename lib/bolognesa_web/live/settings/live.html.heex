<Layouts.app flash={@flash} current_scope={@current_scope} active_section={:settings}>
  <section id="settings-screen" class="mx-auto max-w-2xl space-y-8">
    <header>
      <h1 class="text-3xl font-semibold text-ink">{gettext("Ajustes")}</h1>
      <p class="mt-3 text-muted">{gettext("Personaliza tu experiencia en boloñesa.")}</p>
    </header>
    <section class="rounded-xl bg-surface p-6 sm:p-8">
      <h2 class="text-xl font-semibold text-ink">{gettext("Idioma")}</h2>
      <p class="mt-3 text-sm text-muted">
        {gettext(
          "Tu elección se guarda en tu cuenta y se aplica en todos tus dispositivos al abrir o recargar la web."
        )}
      </p>
      <.form for={@form} id="locale-form" phx-submit="save" class="mt-6 space-y-5">
        <.input
          field={@form[:locale]}
          id="locale-select"
          type="select"
          label={gettext("Idioma de la interfaz")}
          options={[{gettext("Idioma del navegador"), ""}, {"Español", "es"}, {"English", "en"}]}
        />
        <p id="effective-locale" class="text-sm text-muted">
          {gettext("Idioma actual: %{language}",
            language: if(@locale == "en", do: "English", else: "Español")
          )}
        </p>
        <button
          id="save-locale"
          type="submit"
          phx-disable-with={gettext("Guardando…")}
          class="min-h-11 rounded-xl bg-accent px-5 py-3 font-semibold text-canvas hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {gettext("Guardar")}
        </button>
      </.form>
    </section>
  </section>
</Layouts.app>
