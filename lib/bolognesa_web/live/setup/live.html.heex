<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="setup-screen"
    class="mx-auto max-w-lg rounded-3xl border border-amber-200/10 bg-zinc-900 p-6 shadow-2xl sm:p-10"
  >
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">Primer acceso</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-stone-50">
      Prepara tu biblioteca
    </h1>
    <p class="mt-3 text-sm leading-6 text-stone-300">
      Crea la cuenta administradora para comenzar. Después, el alta quedará cerrada.
    </p>

    <.form
      for={@form}
      id="setup-form"
      phx-change="validate"
      phx-submit="save"
      class="mt-8 space-y-4"
    >
      <.input
        field={@form[:name]}
        id="setup-name"
        type="text"
        label="Nombre"
        autocomplete="name"
        required
        class="w-full rounded-xl border border-stone-600 bg-stone-800 px-4 py-3 text-stone-50 outline-none transition focus:border-amber-300 focus:ring-2 focus:ring-amber-300/30"
      />
      <.input
        field={@form[:email]}
        id="setup-email"
        type="email"
        label="Correo electrónico"
        autocomplete="email"
        required
        class="w-full rounded-xl border border-stone-600 bg-stone-800 px-4 py-3 text-stone-50 outline-none transition focus:border-amber-300 focus:ring-2 focus:ring-amber-300/30"
      />
      <.input
        field={@form[:password]}
        id="setup-password"
        type="password"
        label="Contraseña"
        autocomplete="new-password"
        required
        class="w-full rounded-xl border border-stone-600 bg-stone-800 px-4 py-3 text-stone-50 outline-none transition focus:border-amber-300 focus:ring-2 focus:ring-amber-300/30"
      />
      <.input
        field={@form[:password_confirmation]}
        id="setup-password-confirmation"
        type="password"
        label="Repite la contraseña"
        autocomplete="new-password"
        required
        class="w-full rounded-xl border border-stone-600 bg-stone-800 px-4 py-3 text-stone-50 outline-none transition focus:border-amber-300 focus:ring-2 focus:ring-amber-300/30"
      />
      <button
        id="setup-submit"
        type="submit"
        phx-disable-with="Creando cuenta…"
        class="mt-3 min-h-12 w-full rounded-xl bg-amber-300 px-5 py-3 font-semibold text-stone-950 transition hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
      >Crear cuenta</button>
    </.form>
  </section>
</Layouts.app>
