<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="setup-screen"
    class="mx-auto max-w-lg rounded-3xl border border-accent/10 bg-surface p-6 shadow-2xl sm:p-10"
  >
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
      {gettext("Primer acceso")}
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">
      {gettext("Prepara tu biblioteca")}
    </h1>
    <p class="mt-3 text-sm leading-6 text-muted">
      {gettext("Crea la cuenta administradora para comenzar. Después, el alta quedará cerrada.")}
    </p>

    <.form
      for={@form}
      id="setup-form"
      phx-change="validate"
      phx-submit="save"
      class="mt-8 space-y-4"
    >
      <.input
        field={@form[:name]}
        id="setup-name"
        type="text"
        label={gettext("Nombre")}
        autocomplete="name"
        required
        class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/30"
      />
      <.input
        field={@form[:email]}
        id="setup-email"
        type="email"
        label={gettext("Correo electrónico")}
        autocomplete="email"
        required
        class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/30"
      />
      <.input
        field={@form[:password]}
        id="setup-password"
        type="password"
        label={gettext("Contraseña")}
        autocomplete="new-password"
        required
        class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/30"
      />
      <.input
        field={@form[:password_confirmation]}
        id="setup-password-confirmation"
        type="password"
        label={gettext("Repite la contraseña")}
        autocomplete="new-password"
        required
        class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/30"
      />
      <button
        id="setup-submit"
        type="submit"
        phx-disable-with={gettext("Creando cuenta…")}
        class="mt-3 min-h-12 w-full rounded-xl bg-accent px-5 py-3 font-semibold text-canvas transition hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >{gettext("Crear cuenta")}</button>
    </.form>
  </section>
</Layouts.app>
