<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:home}
>
  <section id="home-screen" class="mx-auto max-w-5xl">
    <div class="welcome-panel p-7 sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
        {gettext("Inicio")}
      </p>
      <h1
        id="home-welcome"
        class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
      >
        {gettext("Hola, %{name}", name: @admin_name)}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        {gettext(
          "Configura una carpeta de películas o series para empezar a construir tu biblioteca."
        )}
      </p>
      <.link
        navigate={~p"/libraries"}
        id="home-libraries-link"
        class={button_variant(%{size: "lg"}, "mt-7")}
      >
        {gettext("Configurar bibliotecas")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
      <.link
        navigate={~p"/movies"}
        id="home-movies-link"
        class={button_variant(%{variant: "outline", size: "lg"}, "mt-3 sm:ml-3 sm:mt-0")}
      >{gettext("Ver películas")}</.link>
      <.link
        navigate={~p"/series"}
        id="home-series-link"
        class={button_variant(%{variant: "outline", size: "lg"}, "ml-3 mt-3")}
      >{gettext("Ver series")}</.link>
      <div class="mt-10 flex flex-col gap-4 border-t border-border/70 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          {gettext("Sesión iniciada como %{email}", email: @admin_email)}
        </p>
        <.form for={@logout_form} action={~p"/logout"} method="delete" id="logout-form">
          <Button.button id="logout-button" type="submit" variant="outline">
            {gettext("Cerrar sesión")}
          </Button.button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
