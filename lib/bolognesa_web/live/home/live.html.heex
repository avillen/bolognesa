<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="home-screen" class="mx-auto max-w-5xl">
    <div class="rounded-3xl border border-amber-200/10 bg-zinc-900 p-7 shadow-2xl sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">Inicio</p>
      <h1
        id="home-welcome"
        class="mt-4 text-4xl font-semibold tracking-tight text-stone-50 sm:text-5xl"
      >
        Hola, {@admin_name}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-stone-300">
        Tu biblioteca está lista para empezar. El siguiente paso será configurar una carpeta de películas.
      </p>
      <div class="mt-10 flex flex-col gap-4 border-t border-stone-700/70 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-stone-400">Sesión iniciada como {@admin_email}</p>
        <.form for={@logout_form} action={~p"/logout"} method="delete" id="logout-form">
          <button
            id="logout-button"
            type="submit"
            class="min-h-11 rounded-xl border border-stone-600 px-5 py-2 text-sm font-medium text-stone-200 transition hover:border-amber-300 hover:text-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >Cerrar sesión</button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
