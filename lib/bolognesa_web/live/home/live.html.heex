<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="home-screen" class="mx-auto max-w-5xl">
    <div class="rounded-3xl border border-amber-200/10 bg-zinc-900 p-7 shadow-2xl sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">Inicio</p>
      <h1
        id="home-welcome"
        class="mt-4 text-4xl font-semibold tracking-tight text-stone-50 sm:text-5xl"
      >
        Hola, {@admin_name}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-stone-300">
        Configura una carpeta de películas para empezar a construir tu biblioteca.
      </p>
      <.link
        navigate={~p"/libraries"}
        id="home-libraries-link"
        class="mt-7 inline-flex min-h-12 items-center rounded-xl bg-amber-300 px-6 py-3 font-semibold text-stone-950 transition hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
      >
        Configurar bibliotecas <.icon name="hero-arrow-right" class="ml-2 size-4" />
      </.link>
      <.link
        navigate={~p"/movies"}
        id="home-movies-link"
        class="ml-0 mt-3 inline-flex min-h-12 items-center rounded-xl border border-amber-300/40 px-6 py-3 font-semibold text-amber-200 transition hover:bg-amber-300/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200 sm:ml-3 sm:mt-0"
      >Ver películas</.link>
      <div class="mt-10 flex flex-col gap-4 border-t border-stone-700/70 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-stone-400">Sesión iniciada como {@admin_email}</p>
        <.form for={@logout_form} action={~p"/logout"} method="delete" id="logout-form">
          <button
            id="logout-button"
            type="submit"
            class="min-h-11 rounded-xl border border-stone-600 px-5 py-2 text-sm font-medium text-stone-200 transition hover:border-amber-300 hover:text-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >Cerrar sesión</button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
