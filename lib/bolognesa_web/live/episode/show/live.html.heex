<Layouts.app flash={@flash} current_scope={@current_scope} active_section={:series}>
  <section id="episode-detail" class="mx-auto max-w-5xl space-y-8">
    <.link
      navigate={~p"/series"}
      class="inline-flex min-h-11 items-center text-sm font-medium text-accent-soft hover:text-accent-soft"
    >{gettext("← Todas las series")}</.link>
    <p :if={@loading?} id="episode-loading" role="status" class="text-muted">
      {gettext("Cargando ficha…")}
    </p>
    <p
      :if={@error}
      id="episode-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail} class="detail-panel">
      <div class="detail-hero">
        <div
          :if={@detail.episode.still_path}
          class="detail-backdrop"
        >
          <img
            id={"episode-backdrop-#{@detail.episode.id}"}
            phx-hook="ImageFallback"
            phx-update="ignore"
            src={"https://image.tmdb.org/t/p/w780#{@detail.episode.still_path}"}
            alt={gettext("Imagen de %{value0}", value0: @detail.episode.title)}
            class="size-full object-cover"
          />
        </div>
        <div class="detail-heading">
          <div class="detail-copy">
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
              {gettext("Ficha de episodio")}
            </p>
            <h1 id="episode-title" class="mt-4 text-4xl font-semibold tracking-tight text-ink">
              {@detail.episode.title}
            </h1>
            <p class="mt-3 text-sm text-muted">
              {@detail.episode.air_date || gettext("Fecha desconocida")}
            </p>
            <p
              :if={@detail.episode.overview}
              class="mt-7 max-w-3xl text-base leading-7 text-muted"
            >
              {@detail.episode.overview}
            </p>
            <p :if={!@detail.episode.overview} class="mt-7 text-sm text-muted">
              {gettext("Todavía no hay sinopsis.")}
            </p>
            <p
              :if={@multi_episode?}
              id="multi-episode-notice"
              class="mt-6 rounded-xl border border-accent/30 p-4 text-accent-soft"
            >
              {gettext(
                "Los archivos con varios episodios se reproducen desde el principio del archivo completo."
              )}
            </p>
            <.link
              navigate={~p"/series/seasons/#{@detail.season.id}"}
              class="mt-4 inline-flex min-h-11 items-center text-accent-soft"
            >{gettext("Volver a la temporada")}</.link>
          </div>
        </div>
      </div>
      <div class="detail-body">
        <BolognesaWeb.Player.player
          prefix="episode"
          kind={:episode}
          entry_id={@catalog_entry_id}
          selected_file_id={@selected_file_id}
          compatible_session={@compatible_session}
          compatible_ready?={@compatible_ready?}
          compatible_paused?={@compatible_paused?}
          compatible_autoplay?={@compatible_autoplay?}
          playback_error={@playback_error}
          playback_error_reason={@playback_error_reason}
        />
        <h2 class="mt-10 text-xl font-semibold text-ink">
          {gettext("Versiones en tu biblioteca")}
        </h2>
        <div id="episode-versions" phx-update="stream" class="mt-4 space-y-3">
          <div
            :for={{dom_id, version} <- @streams.versions}
            id={dom_id}
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-raised/50 p-4"
          >
            <div>
              <p class="text-sm text-ink">
                {gettext("Versión")} {version.id} · {Float.round(
                  version.size_bytes / 1_048_576,
                  1
                )} {"MB"}
              </p>
              <p :if={version.format} class="text-xs text-muted">
                {version.format} · {Enum.join(version.codecs, " / ")}
              </p>
              <p :if={version.duration_ms} class="text-xs text-muted">
                {gettext("Duración:")} {div(version.duration_ms, 60_000)} {"min"}
              </p>
              <p :if={length(version.episode_numbers) > 1} class="text-xs text-accent-soft">
                {gettext("Contiene episodios")} {Enum.join(version.episode_numbers, ", ")}
              </p>
              <p class="mt-1 text-xs text-muted">
                {if version.origin == :manual,
                  do: gettext("Identificación manual"),
                  else: gettext("Identificación automática")}{if version.needs_review?,
                  do: gettext(" · Revisar"),
                  else: ""}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent-soft">{if version.availability ==
                                                                       :available,
                                                                     do: gettext("Disponible"),
                                                                     else:
                                                                       gettext("No disponible")}</span>
            <button
              :if={version.availability == :available}
              id={"episode-play-#{version.id}"}
              type="button"
              phx-click="play"
              phx-value-file_id={version.id}
              class="min-h-11 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-canvas transition hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {gettext("Reproducir")}
            </button>
            <.link
              navigate={~p"/series/review?#{%{file_id: version.id}}"}
              id={"episode-correct-#{version.id}"}
              class="min-h-11 rounded-xl border border-border-strong px-4 py-3 text-sm text-ink transition hover:border-accent hover:text-accent-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >{gettext("Corregir")}</.link>
          </div>
        </div>
        <p :if={@detail.versions == []} id="episode-no-versions" class="mt-4 text-sm text-muted">
          {gettext("No hay versiones vinculadas.")}
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
