<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <section id="episode-detail" class="series-screen episode-screen mx-auto max-w-5xl">
    <nav
      :if={@detail}
      id="episode-breadcrumb"
      class="episode-breadcrumb"
      aria-label={gettext("Ruta de navegación")}
    >
      <.link
        id="episode-back"
        navigate={~p"/series/seasons/#{@detail.season.id}?#{@season_params}"}
        aria-label={
          if @detail.season.number == 0,
            do: gettext("← Especiales"),
            else: gettext("← Temporada %{number}", number: @detail.season.number)
        }
      ><span aria-hidden="true">←</span></.link>
      <.link
        id="episode-series"
        class="episode-breadcrumb-series"
        title={@detail.series.title}
        navigate={~p"/series/#{@detail.series.id}?#{@series_params}"}
      >{@detail.series.title}</.link>
      <span aria-hidden="true">/</span>
      <.link
        id="episode-season"
        class="shrink-0"
        navigate={~p"/series/seasons/#{@detail.season.id}?#{@season_params}"}
      >
        {if @detail.season.number == 0,
          do: gettext("Especiales"),
          else: gettext("Temporada %{value0}", value0: @detail.season.number)}
      </.link>
    </nav>
    <p :if={@loading?} id="episode-loading" role="status" class="text-muted">
      {gettext("Cargando ficha…")}
    </p>
    <p
      :if={@error}
      id="episode-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
      <.link
        navigate={~p"/series?#{@catalog_params}"}
        class="block min-h-11 py-3 text-accent-soft"
      >{gettext("← Todas las series")}</.link>
    </p>
    <div :if={@detail}>
      <header class="episode-heading">
        <h1 id="episode-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {@detail.episode.title}
        </h1>
        <p class="mt-1 flex items-center gap-2 text-xs text-muted">
          <span>{gettext("Episodio %{number}", number: @detail.episode.number)}</span>
          <span
            :for={version <- @detail.versions}
            :if={version.id == @selected_file_id && version.duration_ms}
          >
            <span aria-hidden="true">·</span>
            {gettext("%{minutes} min", minutes: div(version.duration_ms, 60_000))}
          </span>
        </p>
      </header>
      <BolognesaWeb.Player.player
        prefix="episode"
        kind={:episode}
        retry_file_id={
          Enum.find_value(@detail.versions, &(&1.availability == :available && &1.id))
        }
        class="episode-player space-y-3"
        poster={
          @detail.episode.still_path &&
            "https://image.tmdb.org/t/p/w780#{@detail.episode.still_path}"
        }
        entry_id={elem(@content_ref, 1)}
        selected_file_id={@selected_file_id}
        compatible_session={@compatible_session}
        compatible_ready?={@compatible_ready?}
        compatible_paused?={@compatible_paused?}
        compatible_autoplay?={@compatible_autoplay?}
        playback_error={@playback_error}
        playback_error_reason={@playback_error_reason}
      />
      <nav
        :if={@detail.previous_episode_id || @detail.next_episode_id}
        id="episode-navigation"
        class="episode-navigation"
        aria-label={gettext("Navegación entre episodios")}
      >
        <.link
          :if={@detail.previous_episode_id}
          id="episode-previous"
          rel="prev"
          navigate={
            ~p"/episodes/#{@detail.previous_episode_id}?#{Navigation.episode_params(@series_params, Map.get(@season_params, :page, 1))}"
          }
          aria-label={gettext("Anterior episodio")}
        >
          <span aria-hidden="true">←</span>
          <span class="sm:hidden">{gettext("Anterior")}</span><span class="hidden sm:inline">{gettext(
            "Anterior episodio"
          )}</span>
        </.link>
        <.link
          :if={@detail.next_episode_id}
          id="episode-next"
          rel="next"
          navigate={
            ~p"/episodes/#{@detail.next_episode_id}?#{Navigation.episode_params(@series_params, Map.get(@season_params, :page, 1))}"
          }
          aria-label={gettext("Siguiente episodio")}
        >
          <span class="sm:hidden">{gettext("Siguiente")}</span><span class="hidden sm:inline">{gettext(
            "Siguiente episodio"
          )}</span>
          <span aria-hidden="true">→</span>
        </.link>
      </nav>
      <p
        :if={!Enum.any?(@detail.versions, &(&1.availability == :available))}
        id="episode-unavailable"
        class="episode-unavailable"
        role="status"
      >
        {gettext("No disponible")} · {gettext("No hay versiones disponibles para este episodio.")}
      </p>
      <p :if={@multi_episode?} id="multi-episode-notice" class="mt-4 text-xs leading-6 text-muted">
        {gettext(
          "Los archivos con varios episodios se reproducen desde el principio del archivo completo."
        )}
      </p>
      <section id="episode-synopsis" class="episode-synopsis">
        <h2 class="mb-3 text-base font-semibold text-ink">{gettext("Sinopsis")}</h2>
        <BolognesaWeb.Series.Components.synopsis
          :if={@detail.episode.overview}
          id="episode-description"
          text={@detail.episode.overview}
        />
        <p :if={!@detail.episode.overview} class="text-sm text-muted">
          {gettext("Todavía no hay sinopsis.")}
        </p>
        <p :if={@detail.episode.air_date} id="episode-air-date" class="mt-3 text-xs text-muted">
          {gettext("Emisión original:")}
          <time datetime={Date.to_iso8601(@detail.episode.air_date)}>{air_date(
            @detail.episode.air_date
          )}</time>
        </p>
      </section>
      <details
        id="episode-playback-options"
        class="episode-playback-options"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary>{gettext("Opciones de reproducción")}</summary>
        <p class="mb-4 text-xs leading-6 text-muted">
          {gettext("Las versiones pueden proceder de otras bibliotecas.")}
        </p>
        <div id="episode-versions" class="space-y-4">
          <article
            :for={version <- @detail.versions}
            id={"episode-version-#{version.id}"}
            class="episode-version"
          >
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm font-semibold text-ink">
                {version.format || gettext("Archivo de vídeo")} · {Float.round(
                  version.size_bytes / 1_048_576,
                  1
                )} MB
              </h3>
              <span
                :if={version.id == @selected_file_id}
                id={"episode-selected-#{version.id}"}
                class="episode-selected"
              >{gettext("Seleccionada")}</span>
              <span :if={version.availability != :available} class="text-xs text-muted">{gettext(
                "No disponible"
              )}</span>
            </div>
            <details
              id={"episode-technical-#{version.id}"}
              class="episode-technical"
              phx-mounted={JS.ignore_attributes("open")}
            >
              <summary>{gettext("Detalles del archivo")}</summary>
              <p :if={version.codecs != []}>{Enum.join(version.codecs, " / ")}</p>
              <p :if={version.duration_ms}>
                {gettext("Duración:")} {div(version.duration_ms, 60_000)} min
              </p>
              <p :if={length(version.episode_numbers) > 1}>
                {gettext("Contiene episodios")} {Enum.join(version.episode_numbers, ", ")}
              </p>
              <p>
                {if version.origin == :manual,
                  do: gettext("Identificación manual"),
                  else: gettext("Identificación automática")}{if version.needs_review?,
                  do: gettext(" · Revisar"),
                  else: ""}
              </p>
              <.link
                navigate={~p"/series/review?#{%{file_id: version.id}}"}
                id={"episode-correct-#{version.id}"}
                class="inline-flex min-h-11 items-center text-accent-soft"
              >
                {gettext("Corregir identificación")}
              </.link>
            </details>
            <button
              :if={version.availability == :available && version.id != @selected_file_id}
              id={"episode-play-#{version.id}"}
              type="button"
              phx-click="play"
              phx-value-file_id={version.id}
              class="series-episode-play"
            >
              {gettext("Elegir esta versión")}
            </button>
          </article>
        </div>
        <p :if={@detail.versions == []} id="episode-no-versions" class="mt-4 text-sm text-muted">
          {gettext("No hay versiones vinculadas.")}
        </p>
      </details>
    </div>
  </section>
</Layouts.app>
