<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="episode-detail" class="mx-auto max-w-5xl space-y-8">
    <.link
      navigate={~p"/series"}
      class="inline-flex min-h-11 items-center text-sm font-medium text-amber-200 hover:text-amber-100"
    >← Todas las series</.link>
    <p :if={@loading?} id="episode-loading" role="status" class="text-stone-300">
      Cargando ficha…
    </p>
    <p
      :if={@error}
      id="episode-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail} class="rounded-3xl border border-stone-700 bg-zinc-900 p-7 sm:p-10">
      <div
        :if={@detail.episode.still_path}
        class="mb-8 aspect-[21/9] overflow-hidden rounded-2xl bg-stone-800"
      >
        <img
          id={"episode-backdrop-#{@detail.episode.id}"}
          phx-hook="ImageFallback"
          phx-update="ignore"
          src={"https://image.tmdb.org/t/p/w780#{@detail.episode.still_path}"}
          alt={"Imagen de #{@detail.episode.title}"}
          class="size-full object-cover"
        />
      </div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">
        Ficha de episodio
      </p>
      <h1 id="episode-title" class="mt-4 text-4xl font-semibold tracking-tight text-stone-50">
        {@detail.episode.title}
      </h1>
      <p class="mt-3 text-sm text-stone-400">{@detail.episode.air_date || "Fecha desconocida"}</p>
      <p :if={@detail.episode.overview} class="mt-7 max-w-3xl text-base leading-7 text-stone-300">
        {@detail.episode.overview}
      </p>
      <p :if={!@detail.episode.overview} class="mt-7 text-sm text-stone-400">
        Todavía no hay sinopsis.
      </p>
      <p
        :if={@multi_episode?}
        id="multi-episode-notice"
        class="mt-6 rounded-xl border border-amber-300/30 p-4 text-amber-100"
      >
        Los archivos con varios episodios se reproducen desde el principio del archivo completo.
      </p>
      <.link
        navigate={~p"/series/seasons/#{@detail.season.id}"}
        class="mt-4 inline-flex min-h-11 items-center text-amber-200"
      >Volver a la temporada</.link>
      <BolognesaWeb.Player.player
        prefix="episode"
        kind={:episode}
        entry_id={@catalog_entry_id}
        selected_file_id={@selected_file_id}
        compatible_session={@compatible_session}
        compatible_ready?={@compatible_ready?}
        compatible_paused?={@compatible_paused?}
        compatible_autoplay?={@compatible_autoplay?}
        playback_error={@playback_error}
        playback_error_reason={@playback_error_reason}
      />
      <h2 class="mt-10 text-xl font-semibold text-stone-50">Versiones en tu biblioteca</h2>
      <div id="episode-versions" phx-update="stream" class="mt-4 space-y-3">
        <div
          :for={{dom_id, version} <- @streams.versions}
          id={dom_id}
          class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-700 bg-stone-800/50 p-4"
        >
          <div>
            <p class="text-sm text-stone-200">
              Versión {version.id} · {Float.round(version.size_bytes / 1_048_576, 1)} MB
            </p>
            <p :if={version.format} class="text-xs text-stone-400">
              {version.format} · {Enum.join(version.codecs, " / ")}
            </p>
            <p :if={version.duration_ms} class="text-xs text-stone-400">
              Duración: {div(version.duration_ms, 60_000)} min
            </p>
            <p :if={length(version.episode_numbers) > 1} class="text-xs text-amber-200">
              Contiene episodios {Enum.join(version.episode_numbers, ", ")}
            </p>
            <p class="mt-1 text-xs text-stone-400">
              {if version.origin == :manual,
                do: "Identificación manual",
                else: "Identificación automática"}{if version.needs_review?,
                do: " · Revisar",
                else: ""}
            </p>
          </div>
          <span class="text-xs font-semibold text-amber-200">{if version.availability ==
                                                                   :available,
                                                                 do: "Disponible",
                                                                 else: "No disponible"}</span>
          <button
            :if={version.availability == :available}
            id={"episode-play-#{version.id}"}
            type="button"
            phx-click="play"
            phx-value-file_id={version.id}
            class="min-h-11 rounded-xl bg-amber-300 px-5 py-3 text-sm font-semibold text-stone-950 transition hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >
            Reproducir
          </button>
          <.link
            navigate={~p"/series/review?#{%{file_id: version.id}}"}
            id={"episode-correct-#{version.id}"}
            class="min-h-11 rounded-xl border border-stone-600 px-4 py-3 text-sm text-stone-200 transition hover:border-amber-300 hover:text-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >Corregir</.link>
        </div>
      </div>
      <p :if={@detail.versions == []} id="episode-no-versions" class="mt-4 text-sm text-stone-400">
        No hay versiones vinculadas.
      </p>
    </div>
  </section>
</Layouts.app>
