<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <section id="episode-detail" class="series-screen episode-screen mx-auto max-w-5xl">
    <nav
      :if={@detail}
      id="episode-breadcrumb"
      class="episode-breadcrumb"
      aria-label={gettext("Ruta de navegación")}
    >
      <.link
        id="episode-back"
        navigate={~p"/series/seasons/#{@detail.season.id}?#{@season_params}"}
        aria-label={
          if @detail.season.number == 0,
            do: gettext("← Especiales"),
            else: gettext("← Temporada %{number}", number: @detail.season.number)
        }
      ><span aria-hidden="true">←</span></.link>
      <.link
        id="episode-series"
        class="episode-breadcrumb-series"
        title={@detail.series.title}
        navigate={~p"/series/#{@detail.series.id}?#{@series_params}"}
      >{@detail.series.title}</.link>
      <span aria-hidden="true">/</span>
      <.link
        id="episode-season"
        class="shrink-0"
        navigate={~p"/series/seasons/#{@detail.season.id}?#{@season_params}"}
      >
        {if @detail.season.number == 0,
          do: gettext("Especiales"),
          else: gettext("Temporada %{value0}", value0: @detail.season.number)}
      </.link>
    </nav>
    <%!-- Keep status changes from moving the fullscreen player ancestor during patches. --%>
    <div id="episode-status">
      <p :if={@loading?} id="episode-loading" role="status" class="text-muted">
        {gettext("Cargando ficha…")}
      </p>
      <p
        :if={@error}
        id="episode-error"
        role="alert"
        class="rounded-xl border border-red-300/30 p-5 text-red-100"
      >
        {@error}
        <.link
          navigate={~p"/series?#{@catalog_params}"}
          class="block min-h-11 py-3 text-accent-soft"
        >{gettext("← Todas las series")}</.link>
      </p>
    </div>
    <div :if={@detail && !@error}>
      <header class="episode-heading">
        <h1 id="episode-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {if @active_part,
            do:
              gettext("%{title} (Parte %{number})",
                title: @detail.episode.title,
                number: @active_part
              ),
            else: @detail.episode.title}
        </h1>
        <p class="mt-1 flex items-center gap-2 text-xs text-muted">
          <span>{gettext("Episodio %{number}", number: @detail.episode.number)}</span>
          <span
            :for={version <- @playback_versions}
            :if={version.id == @selected_file_id && version.duration_ms}
          >
            <span aria-hidden="true">·</span>
            {gettext("%{minutes} min", minutes: div(version.duration_ms, 60_000))}
          </span>
        </p>
      </header>
      <nav
        :if={@parts != []}
        id="episode-parts"
        aria-label={gettext("Partes del episodio")}
        class="my-3 flex flex-wrap gap-3"
      >
        <.link
          :for={part <- @parts}
          patch={
            ~p"/episodes/#{@detail.episode.id}?#{Navigation.episode_target_params(@series_params, Map.get(@season_params, :page, 1), %{part_number: part})}"
          }
          aria-current={if part == @active_part, do: "page"}
          class="min-h-11 py-3 text-accent-soft"
        >
          {gettext("Parte %{number}", number: part)}
        </.link>
      </nav>
      <Player.player
        prefix="episode"
        kind={:episode}
        viewer_id={@current_scope.actor.id}
        retry_file_id={Enum.find_value(@part_versions, &(&1.availability == :available && &1.id))}
        class="episode-player space-y-3"
        poster={
          @detail.episode.still_path &&
            "https://image.tmdb.org/t/p/w780#{@detail.episode.still_path}"
        }
        entry_id={elem(@content_ref, 1)}
        playback_phase={@playback_phase}
        selected_file_id={@selected_file_id}
        transcode_session={@transcode_session}
        playback_attempt_id={@playback_attempt_id}
        playback_probe={@playback_probe}
        delivery_plan={@delivery_plan}
        compatible_playback_available?={@compatible_playback_available?}
        inspection_refresh_used?={@inspection_refresh_used?}
        inspection_refresh_requested?={@inspection_refresh_requested?}
        transcode_ready?={@transcode_ready?}
        transcode_paused?={@transcode_paused?}
        transcode_autoplay?={@transcode_autoplay?}
        playback_error={@playback_error}
        playback_error_reason={@playback_error_reason}
      />
      <EpisodeNavigation.episode_navigation
        :if={@previous_target || @next_target}
        previous_target={@previous_target}
        next_target={@next_target}
        series_params={@series_params}
        season_params={@season_params}
      />
      <p
        :if={!Enum.any?(@part_versions, &(&1.availability == :available))}
        id="episode-unavailable"
        class="episode-unavailable"
        role="status"
      >
        {gettext("No disponible")} · {gettext("No hay versiones disponibles para este episodio.")}
      </p>
      <p :if={@multi_episode?} id="multi-episode-notice" class="mt-4 text-xs leading-6 text-muted">
        {gettext(
          "Los archivos con varios episodios se reproducen desde el principio del archivo completo."
        )}
      </p>
      <section id="episode-synopsis" class="episode-synopsis">
        <h2 class="mb-3 text-base font-semibold text-ink">{gettext("Sinopsis")}</h2>
        <MediaComponents.synopsis
          :if={@detail.episode.overview}
          id="episode-description"
          text={@detail.episode.overview}
        />
        <p :if={!@detail.episode.overview} class="text-sm text-muted">
          {gettext("Todavía no hay sinopsis.")}
        </p>
        <p
          :if={@detail.episode.air_date}
          id="episode-air-date"
          class="mt-3 flex items-center gap-2 text-xs text-muted"
        >
          <span aria-hidden="true"><.icon name="hero-calendar-days" class="size-4 shrink-0" /></span>
          <span>
            {gettext("Emisión original:")}
            <time datetime={Date.to_iso8601(@detail.episode.air_date)}>{air_date(
              @detail.episode.air_date
            )}</time>
          </span>
        </p>
      </section>
      <details
        id="episode-playback-options"
        class="playback-options"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary>{gettext("Opciones de reproducción")}</summary>
        <p class="mb-4 text-xs leading-6 text-muted">
          {gettext("Las versiones pueden proceder de otras bibliotecas.")}
        </p>
        <Player.playback_mode
          playback_phase={@playback_phase}
          selected_file_id={@selected_file_id}
          transcode_session={@transcode_session}
          playback_error={@playback_error}
        />
        <div id="episode-versions" class="space-y-4">
          <VersionCard.version_card
            :for={version <- @playback_versions}
            version={version}
            parts={@parts}
            selected_file_id={@selected_file_id}
          />
        </div>
        <p :if={@detail.versions == []} id="episode-no-versions" class="mt-4 text-sm text-muted">
          {gettext("No hay versiones vinculadas.")}
        </p>
      </details>
    </div>
  </section>
</Layouts.app>
