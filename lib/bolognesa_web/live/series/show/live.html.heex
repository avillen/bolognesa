<Layouts.app flash={@flash} current_scope={@current_scope} active_section={:series}>
  <section class="mx-auto max-w-5xl space-y-7">
    <.link navigate={~p"/series"} class="inline-flex min-h-11 items-center text-accent-soft">← Todas las series</.link>
    <p :if={@loading?} id="series-loading" role="status" class="text-muted">
      Cargando serie…
    </p>
    <p :if={@error} id="series-error" role="alert" class="text-red-200">
      {@error} <button phx-click="retry" class="min-h-11 px-4">Reintentar</button>
    </p>
    <div :if={@detail} class="detail-panel">
      <div class="detail-hero">
        <div :if={@detail.series.backdrop_path} class="detail-backdrop">
          <img
            id={"series-backdrop-#{@detail.series.id}"}
            phx-hook="ImageFallback"
            phx-update="ignore"
            src={"https://image.tmdb.org/t/p/w780#{@detail.series.backdrop_path}"}
            alt={"Imagen de #{@detail.series.title}"}
            class="size-full object-cover"
          />
        </div>
        <div class="detail-heading">
          <div class="detail-copy">
            <h1 id="series-title" class="text-4xl font-semibold text-ink">
              {@detail.series.title}
            </h1>
            <p class="mt-3 text-muted">{@detail.series.year || "Año desconocido"}</p>
            <p :if={@detail.series.overview} class="mt-6 max-w-3xl leading-7 text-muted">
              {@detail.series.overview}
            </p>
          </div>
        </div>
      </div>
      <div class="detail-body">
        <h2 class="mt-8 text-xl font-semibold text-ink">Temporadas en tu biblioteca</h2>
        <p :if={@total == 0} id="seasons-empty" class="mt-4 text-muted">
          No hay temporadas identificadas.
        </p>
        <div id="season-list" phx-update="stream" class="mt-4 grid gap-4 sm:grid-cols-2">
          <article
            :for={{id, season} <- @streams.seasons}
            id={id}
            class="rounded-xl border border-border p-5"
          >
            <.link
              navigate={~p"/series/seasons/#{season.id}"}
              class="inline-flex min-h-11 items-center text-lg font-semibold text-accent-soft"
            >{if season.number == 0, do: "Especiales", else: "Temporada #{season.number}"}</.link>
            <p class="text-sm text-muted">{season.episode_count} episodios identificados</p>
          </article>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
