<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="series-screen" class="mx-auto max-w-5xl space-y-7">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-4xl font-semibold text-ink">Series</h1>
      <.link
        id="series-review-link"
        navigate={~p"/series/review"}
        class="min-h-11 rounded-xl border border-accent/40 px-5 py-3 text-accent-soft"
      >Revisar identificaciones</.link>
    </header>
    <.form
      for={@form}
      id="series-search"
      phx-submit="search"
      class="flex flex-wrap items-end gap-3"
    >
      <.input field={@form[:query]} type="search" label="Buscar series" />
      <button type="submit" class="min-h-11 rounded-xl bg-accent px-5 py-3 text-canvas">Buscar</button>
    </.form>
    <p :if={@loading?} id="series-loading" role="status" class="text-muted">
      Cargando series…
    </p>
    <p :if={@error} id="series-error" role="alert" class="text-red-200">
      {@error} <.link patch={~p"/series?#{%{query: @query, page: @page}}"}>Reintentar</.link>
    </p>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="series-empty"
      class="rounded-xl border border-dashed border-border p-6 text-muted"
    >
      No hay series para esta búsqueda. Añade una biblioteca de series y escanéala para empezar.
    </p>
    <div id="series-list" phx-update="stream" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <article
        :for={{id, series} <- @streams.series}
        id={id}
        class="rounded-2xl border border-border bg-surface p-5"
      >
        <img
          :if={series.poster_path}
          id={"series-poster-#{series.id}"}
          phx-hook="ImageFallback"
          phx-update="ignore"
          src={"https://image.tmdb.org/t/p/w342#{series.poster_path}"}
          alt={"Cartel de #{series.title}"}
          class="mb-4 aspect-[2/3] w-full rounded-xl object-cover"
        />
        <.link
          navigate={~p"/series/#{series.id}"}
          class="inline-flex min-h-11 items-center text-xl font-semibold text-accent-soft"
        >{series.title}</.link>
        <p class="mt-2 text-sm text-muted">
          {series.year || "Año desconocido"} · {series.available_episode_count} de {series.episode_count} episodios disponibles
        </p>
      </article>
    </div>
    <nav aria-label="Páginas de series" class="flex gap-5 text-accent-soft">
      <.link
        :if={@page > 1}
        id="series-previous"
        patch={~p"/series?#{%{query: @query, page: @page - 1}}"}
        class="min-h-11 py-3"
      >Anterior</.link>
      <.link
        :if={@page * 24 < @total}
        id="series-next"
        patch={~p"/series?#{%{query: @query, page: @page + 1}}"}
        class="min-h-11 py-3"
      >Siguiente</.link>
    </nav>
  </section>
</Layouts.app>
