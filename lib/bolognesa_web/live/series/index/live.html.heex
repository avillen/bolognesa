<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <section id="series-screen" class="series-screen mx-auto max-w-6xl space-y-8">
    <header class="series-catalog-heading">
      <div>
        <p class="series-eyebrow">{gettext("Tu biblioteca")}</p>
        <h1 class="mt-3 text-4xl font-semibold text-ink">{@library_name || gettext("Series")}</h1>
      </div>
      <.link id="series-review-link" navigate={~p"/series/review"} class="series-secondary-action">
        <.icon name="hero-adjustments-horizontal" class="size-4" />
        {gettext("Revisar identificaciones")}
      </.link>
    </header>
    <div class="series-toolbar">
      <.form for={@form} id="series-search" phx-submit="search" class="series-search-form">
        <div class="series-search-field">
          <.icon name="hero-magnifying-glass" class="size-5 text-muted" />
          <.input
            field={@form[:query]}
            type="search"
            label={gettext("Buscar series")}
            placeholder={gettext("Buscar por título…")}
            class="series-search-input"
          />
        </div>
        <button type="submit" class="series-primary-action">{gettext("Buscar")}</button>
      </.form>
      <p :if={!@loading? && !@error} id="series-count" class="series-result-count">
        {ngettext("%{count} serie", "%{count} series", @total)}
      </p>
    </div>
    <p :if={@loading?} id="series-loading" role="status" class="text-muted">
      {gettext("Cargando series…")}
    </p>
    <p :if={@error} id="series-error" role="alert" class="text-red-200">
      {@error}
      <.link patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page})}"}>{gettext(
        "Reintentar"
      )}</.link>
    </p>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="series-empty"
      class="rounded-xl border border-dashed border-border p-6 text-muted"
    >
      {gettext(
        "No hay series para esta búsqueda. Añade una biblioteca de series y escanéala para empezar."
      )}
    </p>
    <div id="series-list" phx-update="stream" class="series-poster-grid">
      <article
        :for={{id, series} <- @streams.series}
        id={id}
        class="poster-card series-catalog-card"
      >
        <.link navigate={~p"/series/#{series.id}?#{@library_params}"} class="series-catalog-link">
          <div class="poster-art series-poster-art">
            <div class="series-art-fallback" aria-hidden="true">
              <.icon name="hero-tv" class="size-9" />
              <span>{series.title}</span>
            </div>
            <img
              :if={series.poster_path}
              id={"series-poster-#{series.id}"}
              phx-hook="ImageFallback"
              phx-update="ignore"
              src={"https://image.tmdb.org/t/p/w342#{series.poster_path}"}
              alt={gettext("Cartel de %{value0}", value0: series.title)}
              loading="lazy"
              class="absolute inset-0 size-full object-cover"
            />
            <span class="series-year">{series.year || gettext("Año desconocido")}</span>
          </div>
          <h2 class="mt-4 text-base font-semibold leading-snug text-ink">{series.title}</h2>
        </.link>
        <p class="mt-2 text-xs leading-5 text-muted">
          {ngettext(
            "%{available} de %{count} episodio disponible",
            "%{available} de %{count} episodios disponibles",
            series.episode_count,
            available: series.available_episode_count
          )}
        </p>
      </article>
    </div>
    <nav aria-label={gettext("Páginas de series")} class="series-pagination">
      <.link
        :if={@page > 1}
        id="series-previous"
        patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page - 1})}"}
        class="min-h-11 py-3"
      >{gettext("Anterior")}</.link>
      <.link
        :if={@page * 24 < @total}
        id="series-next"
        patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page + 1})}"}
        class="min-h-11 py-3"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
