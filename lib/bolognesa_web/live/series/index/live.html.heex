<Layouts.app flash={@flash} current_scope={@current_scope} active_section={:series}>
  <section id="series-screen" class="mx-auto max-w-5xl space-y-7">
    <header class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-4xl font-semibold text-ink">{gettext("Series")}</h1>
      <.link
        id="series-review-link"
        navigate={~p"/series/review"}
        class="min-h-11 rounded-xl border border-accent/40 px-5 py-3 text-accent-soft"
      >{gettext("Revisar identificaciones")}</.link>
    </header>
    <.form
      for={@form}
      id="series-search"
      phx-submit="search"
      class="flex flex-wrap items-end gap-3"
    >
      <.input field={@form[:query]} type="search" label={gettext("Buscar series")} />
      <button type="submit" class="min-h-11 rounded-xl bg-accent px-5 py-3 text-canvas">{gettext(
        "Buscar"
      )}</button>
    </.form>
    <p :if={@loading?} id="series-loading" role="status" class="text-muted">
      {gettext("Cargando series…")}
    </p>
    <p :if={@error} id="series-error" role="alert" class="text-red-200">
      {@error}
      <.link patch={~p"/series?#{%{query: @query, page: @page}}"}>{gettext("Reintentar")}</.link>
    </p>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="series-empty"
      class="rounded-xl border border-dashed border-border p-6 text-muted"
    >
      {gettext(
        "No hay series para esta búsqueda. Añade una biblioteca de series y escanéala para empezar."
      )}
    </p>
    <div id="series-list" phx-update="stream" class="poster-grid">
      <article
        :for={{id, series} <- @streams.series}
        id={id}
        class="poster-card"
      >
        <.link navigate={~p"/series/#{series.id}"} class="block rounded-lg">
          <div class="poster-art relative flex aspect-[2/3] items-center justify-center overflow-hidden rounded-lg bg-raised text-4xl text-muted">
            <span aria-hidden="true">{String.first(series.title)}</span>
            <img
              :if={series.poster_path}
              id={"series-poster-#{series.id}"}
              phx-hook="ImageFallback"
              phx-update="ignore"
              src={"https://image.tmdb.org/t/p/w342#{series.poster_path}"}
              alt={gettext("Cartel de %{value0}", value0: series.title)}
              loading="lazy"
              class="absolute inset-0 size-full object-cover"
            />
          </div>
          <h2 class="mt-3 text-sm font-semibold text-ink">{series.title}</h2>
        </.link>
        <p class="mt-1 text-xs text-muted">
          {series.year || gettext("Año desconocido")} · {ngettext(
            "%{available} de %{count} episodio disponible",
            "%{available} de %{count} episodios disponibles",
            series.episode_count,
            available: series.available_episode_count
          )}
        </p>
      </article>
    </div>
    <nav aria-label={gettext("Páginas de series")} class="flex gap-5 text-accent-soft">
      <.link
        :if={@page > 1}
        id="series-previous"
        patch={~p"/series?#{%{query: @query, page: @page - 1}}"}
        class="min-h-11 py-3"
      >{gettext("Anterior")}</.link>
      <.link
        :if={@page * 24 < @total}
        id="series-next"
        patch={~p"/series?#{%{query: @query, page: @page + 1}}"}
        class="min-h-11 py-3"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
