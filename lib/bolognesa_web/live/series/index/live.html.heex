<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <section
    id="series-screen"
    phx-hook="BrowsePosition"
    data-loading={to_string(@loading?)}
    class="series-screen series-catalog mx-auto max-w-6xl space-y-8"
  >
    <header class="media-catalog-heading">
      <div>
        <p class="media-eyebrow">{gettext("Tu biblioteca")}</p>
        <h1 class="mt-3 text-4xl font-semibold text-ink">{@library_name || gettext("Series")}</h1>
      </div>
      <details id="series-library-options" class="series-library-options">
        <summary aria-label={gettext("Opciones de biblioteca")} class="series-options-toggle">
          <.icon name="hero-ellipsis-horizontal" class="size-5" />
        </summary>
        <div class="series-options-menu">
          <.link id="series-review-link" navigate={~p"/series/review"} class="app-nav-link">
            {gettext("Revisar identificaciones")}
          </.link>
        </div>
      </details>
    </header>
    <div class="media-toolbar">
      <.form
        for={@form}
        id="series-search"
        phx-change="search"
        phx-submit="search"
        class="media-search-form"
      >
        <div class="media-search-field">
          <.icon name="hero-magnifying-glass" class="size-5 text-muted" />
          <.input
            field={@form[:query]}
            phx-debounce="300"
            type="search"
            label={gettext("Buscar series")}
            placeholder={gettext("Buscar por título…")}
            class="media-search-input"
          />
        </div>
        <button
          type="submit"
          class="media-primary-action series-search-submit"
          aria-label={gettext("Buscar series")}
        >
          <.icon name="hero-arrow-turn-down-left" class="size-5 sm:hidden" />
          <span class="hidden sm:inline">{gettext("Buscar")}</span>
        </button>
      </.form>
      <p :if={!@loading? && !@error} id="series-count" class="media-result-count">
        {ngettext("%{count} serie", "%{count} series", @total)}
      </p>
    </div>
    <p :if={@loading?} id="series-loading" role="status" class="text-muted">
      {gettext("Cargando series…")}
    </p>
    <p :if={@error} id="series-error" role="alert" class="text-red-200">
      {@error}
      <.link patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page})}"}>{gettext(
        "Reintentar"
      )}</.link>
    </p>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="series-empty"
      class="rounded-xl border border-dashed border-border p-6 text-muted"
    >
      <span :if={@query == ""}>{gettext(
        "No hay series para esta búsqueda. Añade una biblioteca de series y escanéala para empezar."
      )}</span>
      <span :if={@query != ""}>{gettext("No hay series que coincidan con tu búsqueda.")}</span>
      <.link
        :if={@query != ""}
        id="series-clear-search"
        patch={~p"/series?#{@library_params}"}
        class="mt-3 block min-h-11 py-3 text-accent-soft"
      >{gettext("Limpiar búsqueda")}</.link>
    </p>
    <div id="series-list" phx-update="stream" class="media-poster-grid">
      <SeriesCard.series_card
        :for={{id, series} <- @streams.series}
        id={id}
        series={series}
        series_params={@series_params}
      />
    </div>
    <nav aria-label={gettext("Páginas de series")} class="media-pagination">
      <.link
        :if={@page > 1}
        id="series-previous"
        patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page - 1})}"}
        class="min-h-11 py-3"
      >{gettext("Anterior")}</.link>
      <.link
        :if={@page * 24 < @total}
        id="series-next"
        patch={~p"/series?#{Map.merge(@library_params, %{query: @query, page: @page + 1})}"}
        class="min-h-11 py-3"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
