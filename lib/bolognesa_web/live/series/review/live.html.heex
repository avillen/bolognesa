<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <div class="mx-auto max-w-5xl space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-bold">{gettext("Revisión de series")}</h1>
      <.link
        navigate={~p"/series"}
        class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 text-accent-soft hover:bg-raised"
      >{gettext("Volver a series")}</.link>
    </div>
    <p :if={@loading?} role="status">{gettext("Cargando archivos…")}</p>
    <div :if={@error} role="alert" class="rounded-xl border border-red-300/30 p-4 text-red-200">
      {@error}<.link
        patch={~p"/series/review?page=#{@page}&file_id=#{@selected_file_id}"}
        class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 border border-border-strong text-accent-soft"
      >{gettext("Reintentar")}</.link>
    </div>
    <p :if={!@loading? && @total == 0}>{gettext("No hay archivos pendientes de revisión.")}</p>
    <div id="series-review-list" phx-update="stream" class="space-y-3">
      <article
        :for={{dom_id, item} <- @streams.reviews}
        id={dom_id}
        class="rounded-2xl border border-border bg-surface p-4"
      >
        <p class="font-semibold break-all">{item.filename}</p>
        <p>{state_label(item.state)} · {failure_label(item.failure_reason)}</p>
        <p :if={item.episode_numbers != []}>
          {item.series_title} {gettext("· temporada")} {item.season_number} {gettext(
            "· episodios"
          )} {Enum.join(
            item.episode_numbers,
            ", "
          )}
        </p>
        <p :if={item.availability == :missing}>{gettext("Archivo no disponible")}</p>
        <.link
          :if={!@saving?}
          patch={~p"/series/review?page=#{@page}&file_id=#{item.file_id}"}
          class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 border border-border-strong text-accent-soft"
          aria-disabled={@saving?}
        >{gettext("Corregir")}</.link>
        <button
          phx-click="retry"
          phx-value-file_id={item.file_id}
          disabled={@saving?}
          class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 text-accent-soft hover:bg-raised"
        >{gettext("Reintentar identificación")}</button>
      </article>
    </div>
    <nav :if={@total > 24} aria-label={gettext("Paginación")} class="flex gap-4">
      <.link :if={@page > 1} patch={~p"/series/review?page=#{@page - 1}"}>{gettext("Anterior")}</.link>
      <span>{gettext("Página %{page}", page: @page)}</span>
      <.link :if={@page * 24 < @total} patch={~p"/series/review?page=#{@page + 1}"}>{gettext(
        "Siguiente"
      )}</.link>
    </nav>
    <section
      :if={@selected_item}
      id="series-file-correction"
      class="space-y-4 rounded-2xl border border-border bg-surface p-5"
    >
      <h2 class="text-xl font-semibold break-all">
        {gettext("Corregir")} {@selected_item.filename}
      </h2>
      <p :if={@selected_item.episode_numbers != []}>
        {gettext("Actual:")} {@selected_item.series_title} {gettext("· temporada")} {@selected_item.season_number} {gettext(
          "· episodios"
        )} {Enum.join(
          @selected_item.episode_numbers,
          ", "
        )}
      </p>
      <p>
        {gettext(
          "La selección sustituye todos los episodios asociados a este archivo. Especiales: temporada 0."
        )}
      </p>
      <.form
        for={@search_form}
        id="series-search"
        phx-submit="search"
        class="flex flex-wrap gap-2 items-end"
      >
        <.input
          field={@search_form[:query]}
          label={gettext("Buscar serie en TMDb")}
          disabled={@saving?}
        />
        <button
          class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 bg-accent text-canvas hover:bg-accent-hover"
          disabled={@saving? || @searching?}
        >{gettext("Buscar")}</button>
      </.form>
      <p :if={@searching?} role="status">{gettext("Buscando series…")}</p>
      <div id="series-candidates" phx-update="stream" class="flex flex-wrap gap-2">
        <button
          :for={{dom_id, candidate} <- @streams.candidates}
          id={dom_id}
          phx-click="choose"
          phx-value-id={candidate.provider_id}
          disabled={@saving?}
          class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 border border-border-strong text-accent-soft hover:border-accent"
        >{candidate.title} {candidate.year}</button>
      </div>
      <div :if={@series_id} class="space-y-4">
        <p>{gettext("Serie seleccionada:")} {@series_title}</p>
        <.form
          for={@season_form}
          id="series-season-form"
          phx-submit="season"
          class="flex flex-wrap gap-2 items-end"
        >
          <.input
            type="number"
            field={@season_form[:number]}
            label={gettext("Temporada")}
            min="0"
            disabled={@saving?}
          />
          <button
            class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 border border-border-strong text-accent-soft"
            disabled={@saving? || @season_loading?}
          >{gettext("Cargar episodios")}</button>
        </.form>
        <p :if={@season_loading?} role="status">{gettext("Cargando temporada…")}</p>
        <.form
          for={@selection_form}
          id="series-correction-form"
          phx-submit="correct"
          class="space-y-3"
        >
          <input type="hidden" name="selection[episode_numbers][]" value="" />
          <div id="series-episode-selection" phx-update="stream" class="space-y-2">
            <label
              :for={{dom_id, episode} <- @streams.episodes}
              id={dom_id}
              class="flex gap-3 items-center"
            >
              <input
                type="checkbox"
                name="selection[episode_numbers][]"
                value={episode.number}
                disabled={@saving?}
                class="size-5 shrink-0 accent-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              />
              <span>{episode.number}. {episode.title}</span>
            </label>
          </div>
          <button
            class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 bg-accent text-canvas hover:bg-accent-hover"
            disabled={@saving? || @season_number == nil || @episode_numbers == []}
          >{if @saving?, do: gettext("Guardando…"), else: gettext("Guardar selección completa")}</button>
        </.form>
      </div>
      <button
        phx-click="unidentified"
        disabled={@saving?}
        class="min-h-11 inline-flex items-center justify-center rounded-xl px-4 py-3 font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-wait disabled:opacity-50 text-accent-soft hover:bg-raised"
      >{gettext("Marcar sin identificar")}</button>
    </section>
    <p
      :if={@feedback}
      id="series-review-feedback"
      role="status"
      class="rounded-xl border border-accent/30 p-4 text-accent-soft"
    >
      {@feedback}
    </p>
  </div>
</Layouts.app>
