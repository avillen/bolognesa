<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:series}
>
  <section
    id="season-screen"
    phx-hook="BrowsePosition"
    data-loading={to_string(@loading?)}
    class="series-screen mx-auto max-w-6xl space-y-6"
  >
    <.link
      :if={@detail}
      id="season-back"
      navigate={~p"/series/#{@detail.series.id}?#{@series_params}"}
      class="media-back-link"
    >{gettext("← %{title}", title: @detail.series.title)}</.link>
    <nav :if={@detail} class="series-breadcrumbs" aria-label={gettext("Ruta de navegación")}>
      <.link navigate={~p"/series?#{@catalog_params}"}>{@library_name || gettext("Series")}</.link>
      <span aria-hidden="true">/</span>
      <.link navigate={~p"/series/#{@detail.series.id}?#{@series_params}"}>{@detail.series.title}</.link>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{if @detail.season.number == 0,
        do: gettext("Especiales"),
        else: gettext("Temporada %{value0}", value0: @detail.season.number)}</span>
    </nav>
    <p :if={@loading?} id="episodes-loading" role="status" class="text-muted">
      {gettext("Cargando episodios…")}
    </p>
    <p :if={@error} id="episodes-error" role="alert" class="text-red-200">
      {@error} <button phx-click="retry" class="min-h-11 px-4">{gettext("Reintentar")}</button>
    </p>
    <header :if={@detail} class="series-season-heading">
      <h1 id="season-title" class="text-3xl font-semibold text-ink">
        {if @detail.season.number == 0,
          do: gettext("Especiales"),
          else: gettext("Temporada %{value0}", value0: @detail.season.number)}
      </h1>
      <p class="mt-3 text-xs leading-6 text-muted">
        {gettext("Episodios identificados en tu biblioteca. La numeración puede tener saltos.")}
      </p>
      <p :if={@total == 0} id="episodes-empty" class="mt-5 text-muted">
        {gettext("No hay episodios identificados.")}
      </p>
    </header>
    <div id="episode-list" phx-update="stream" class="series-episode-list">
      <EpisodeCard.episode_card
        :for={{id, episode} <- @streams.episodes}
        id={id}
        episode={episode}
        series_params={@series_params}
        page={@page}
      />
    </div>
    <nav aria-label={gettext("Páginas de episodios")} class="media-pagination">
      <.link
        :if={@page > 1}
        patch={
          ~p"/series/seasons/#{@content_id}?#{Map.merge(@series_params, %{page: @page - 1})}"
        }
        class="min-h-11 py-3"
      >{gettext("Anterior")}</.link>
      <.link
        :if={@page * 24 < @total}
        patch={
          ~p"/series/seasons/#{@content_id}?#{Map.merge(@series_params, %{page: @page + 1})}"
        }
        class="min-h-11 py-3"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
