<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:libraries}
>
  <section id="libraries-screen" class="mx-auto max-w-6xl space-y-6">
    <header class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
          {gettext("Biblioteca")}
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          {gettext("Bibliotecas")}
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
          {gettext("Gestiona tus fuentes multimedia y sus escaneos.")}
        </p>
      </div>
      <button
        id="library-add"
        type="button"
        phx-click="open_library_form"
        aria-haspopup="dialog"
        aria-controls="library-create-panel"
        class="library-primary shrink-0"
      >
        <.icon name="hero-plus" class="size-4" />{gettext("Añadir biblioteca")}
      </button>
    </header>
    <p
      :if={@success}
      id="library-success"
      role="status"
      class="mt-5 rounded-xl border border-emerald-400/30 bg-emerald-400/10 p-4 text-sm text-emerald-200"
    >
      {@success}
    </p>

    <p
      :if={@load_error}
      id="library-load-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-4 text-sm text-red-200"
    >
      {@load_error}
    </p>
    <p
      :if={@scan_feedback}
      id="library-scan-feedback"
      role="status"
      class="rounded-xl border border-border p-4 text-sm text-ink"
    >
      {@scan_feedback}
    </p>
    <p
      :if={@scan_refresh_error == :unavailable}
      id="library-scan-refresh-error"
      role="alert"
      class="rounded-xl border border-border p-4 text-sm text-ink"
    >
      {gettext("No se pudo actualizar el escaneo. Vuelve a intentarlo.")}
    </p>
    <section class="library-section" aria-labelledby="registered-libraries-title">
      <h2
        id="registered-libraries-title"
        class="px-1 pb-4 text-base font-semibold text-ink md:px-5 md:pt-5"
      >
        {gettext("Bibliotecas registradas")}
      </h2>
      <div class="library-columns library-list-heading" aria-hidden="true">
        <span>{gettext("Biblioteca")}</span><span>{gettext("Carpeta de origen")}</span><span>{gettext(
          "Archivos"
        )}</span><span>{gettext("Estado")}</span><span class="text-right">{gettext("Acciones")}</span>
      </div>
      <div id="library-list" phx-update="stream" class="library-list">
        <div
          :if={is_nil(@load_error)}
          id="libraries-empty"
          class="hidden rounded-xl border border-dashed border-border p-6 text-sm text-muted only:block"
        >
          <p>{gettext("Todavía no hay bibliotecas.")}</p>
          <button type="button" phx-click="open_library_form" class="library-secondary mt-4">{gettext(
            "Añadir biblioteca"
          )}</button>
        </div>
        <LibraryRow.render :for={{id, library} <- @streams.libraries} id={id} library={library} />
      </div>
    </section>
    <aside class="flex gap-3 rounded-xl border border-border p-5 text-sm leading-6 text-muted">
      <.icon name="hero-information-circle" class="mt-1 size-5 shrink-0" />
      <div>
        <h2 class="font-semibold text-ink">{gettext("¿Qué hace cada acción?")}</h2><p>
          {gettext(
            "Escanear busca cambios en la carpeta y analiza archivos nuevos o modificados. En «Detalles del escaneo» encontrarás Reanalizar, que repite el escaneo y fuerza el análisis técnico de los archivos. Puedes salir de esta pantalla mientras continúa."
          )}
        </p>
      </div>
    </aside>
    <ReinspectConfirmation.render :if={@reinspect_target} target={@reinspect_target} />
    <LibraryForm.render :if={@show_library_form?} form={@form} error={@form_error} />
  </section>
</Layouts.app>
