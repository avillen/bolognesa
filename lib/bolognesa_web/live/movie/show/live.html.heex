<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="movie-detail" class="mx-auto max-w-5xl space-y-8">
    <.link
      navigate={~p"/movies"}
      class="inline-flex min-h-11 items-center text-sm font-medium text-amber-200 hover:text-amber-100"
    >← Todas las películas</.link>
    <p :if={@loading?} id="movie-loading" role="status" class="text-stone-300">Cargando ficha…</p>
    <p
      :if={@error}
      id="movie-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail} class="rounded-3xl border border-stone-700 bg-zinc-900 p-7 sm:p-10">
      <div
        :if={@detail.movie.backdrop_path}
        class="mb-8 aspect-[21/9] overflow-hidden rounded-2xl bg-stone-800"
      >
        <img
          id={"movie-backdrop-#{@detail.movie.id}"}
          phx-hook="ImageFallback"
          phx-update="ignore"
          src={"https://image.tmdb.org/t/p/w780#{@detail.movie.backdrop_path}"}
          alt={"Imagen de #{@detail.movie.title}"}
          class="size-full object-cover"
        />
      </div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">
        Ficha de película
      </p>
      <h1 id="movie-title" class="mt-4 text-4xl font-semibold tracking-tight text-stone-50">
        {@detail.movie.title}
      </h1>
      <p class="mt-3 text-sm text-stone-400">{@detail.movie.year || "Año desconocido"}</p>
      <p :if={@detail.movie.overview} class="mt-7 max-w-3xl text-base leading-7 text-stone-300">
        {@detail.movie.overview}
      </p>
      <p :if={!@detail.movie.overview} class="mt-7 text-sm text-stone-400">
        Todavía no hay sinopsis.
      </p>
      <section
        :if={@selected_file_id}
        id="movie-player"
        class="mt-10 space-y-3"
        aria-label="Reproductor"
      >
        <h2 class="text-xl font-semibold text-stone-50">
          Reproduciendo versión {@selected_file_id}
        </h2>
        <video
          id={"movie-video-#{@selected_file_id}"}
          phx-hook="VideoError"
          data-file-id={@selected_file_id}
          controls
          playsinline
          preload="metadata"
          src={~p"/movies/#{@detail.movie.id}/media/#{@selected_file_id}"}
          class="aspect-video w-full rounded-xl bg-black"
        >
          Tu navegador no admite la reproducción de vídeo.
        </video>
      </section>
      <p
        :if={@playback_error}
        id="movie-playback-error"
        role="alert"
        data-reason={@playback_error_reason}
        class="mt-4 rounded-xl border border-red-300/30 bg-red-950/30 p-4 text-sm text-red-100"
      >
        {@playback_error}
      </p>
      <h2 class="mt-10 text-xl font-semibold text-stone-50">Versiones en tu biblioteca</h2>
      <div id="movie-versions" phx-update="stream" class="mt-4 space-y-3">
        <div
          :for={{dom_id, version} <- @streams.versions}
          id={dom_id}
          class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-stone-700 bg-stone-800/50 p-4"
        >
          <div>
            <p class="text-sm text-stone-200">Versión {version.id}</p>
            <p class="mt-1 text-xs text-stone-400">
              {if version.origin == :manual,
                do: "Identificación manual",
                else: "Identificación automática"}{if version.needs_review,
                do: " · Revisar",
                else: ""}
            </p>
          </div>
          <span class="text-xs font-semibold text-amber-200">{if version.availability ==
                                                                   :available,
                                                                 do: "Disponible",
                                                                 else: "No disponible"}</span>
          <button
            :if={version.availability == :available}
            id={"movie-play-#{version.id}"}
            type="button"
            phx-click="play"
            phx-value-file_id={version.id}
            class="min-h-11 rounded-xl bg-amber-300 px-5 py-3 text-sm font-semibold text-stone-950 transition hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >
            Reproducir
          </button>
          <.link
            navigate={~p"/movies/review?#{%{file_id: version.id}}"}
            id={"movie-correct-#{version.id}"}
            class="min-h-11 rounded-xl border border-stone-600 px-4 py-3 text-sm text-stone-200 transition hover:border-amber-300 hover:text-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >Corregir</.link>
        </div>
      </div>
      <p :if={@detail.versions == []} id="movie-no-versions" class="mt-4 text-sm text-stone-400">
        No hay versiones vinculadas.
      </p>
    </div>
  </section>
</Layouts.app>
