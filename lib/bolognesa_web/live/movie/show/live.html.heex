<Layouts.app flash={@flash} current_scope={@current_scope} active_section={:movies}>
  <section id="movie-detail" class="mx-auto max-w-5xl space-y-8">
    <.link
      navigate={~p"/movies"}
      class="inline-flex min-h-11 items-center text-sm font-medium text-accent-soft hover:text-accent-soft"
    >← Todas las películas</.link>
    <p :if={@loading?} id="movie-loading" role="status" class="text-muted">Cargando ficha…</p>
    <p
      :if={@error}
      id="movie-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail} class="detail-panel">
      <div class="detail-hero">
        <div
          :if={@detail.movie.backdrop_path}
          class="detail-backdrop"
        >
          <img
            id={"movie-backdrop-#{@detail.movie.id}"}
            phx-hook="ImageFallback"
            phx-update="ignore"
            src={"https://image.tmdb.org/t/p/w780#{@detail.movie.backdrop_path}"}
            alt={"Imagen de #{@detail.movie.title}"}
            class="size-full object-cover"
          />
        </div>
        <div class="detail-heading">
          <img
            :if={@detail.movie.poster_path}
            id={"movie-detail-poster-#{@detail.movie.id}"}
            phx-hook="ImageFallback"
            phx-update="ignore"
            src={"https://image.tmdb.org/t/p/w342#{@detail.movie.poster_path}"}
            alt={"Cartel de #{@detail.movie.title}"}
            class="detail-poster"
          />
          <div class="detail-copy">
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-soft">
              Ficha de película
            </p>
            <h1 id="movie-title" class="mt-4 text-4xl font-semibold tracking-tight text-ink">
              {@detail.movie.title}
            </h1>
            <p class="mt-3 text-sm text-muted">{@detail.movie.year || "Año desconocido"}</p>
            <p :if={@detail.movie.overview} class="mt-7 max-w-3xl text-base leading-7 text-muted">
              {@detail.movie.overview}
            </p>
            <p :if={!@detail.movie.overview} class="mt-7 text-sm text-muted">
              Todavía no hay sinopsis.
            </p>
          </div>
        </div>
      </div>
      <div class="detail-body">
        <BolognesaWeb.Player.player
          prefix="movie"
          kind={:movie}
          entry_id={@catalog_entry_id}
          selected_file_id={@selected_file_id}
          compatible_session={@compatible_session}
          compatible_ready?={@compatible_ready?}
          compatible_paused?={@compatible_paused?}
          compatible_autoplay?={@compatible_autoplay?}
          playback_error={@playback_error}
          playback_error_reason={@playback_error_reason}
        />
        <h2 class="mt-10 text-xl font-semibold text-ink">Versiones en tu biblioteca</h2>
        <div id="movie-versions" phx-update="stream" class="mt-4 space-y-3">
          <div
            :for={{dom_id, version} <- @streams.versions}
            id={dom_id}
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-raised/50 p-4"
          >
            <div>
              <p class="text-sm text-ink">Versión {version.id}</p>
              <p class="mt-1 text-xs text-muted">
                {if version.origin == :manual,
                  do: "Identificación manual",
                  else: "Identificación automática"}{if version.needs_review,
                  do: " · Revisar",
                  else: ""}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent-soft">{if version.availability ==
                                                                       :available,
                                                                     do: "Disponible",
                                                                     else: "No disponible"}</span>
            <button
              :if={version.availability == :available}
              id={"movie-play-#{version.id}"}
              type="button"
              phx-click="play"
              phx-value-file_id={version.id}
              class="min-h-11 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-canvas transition hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              Reproducir
            </button>
            <.link
              navigate={~p"/movies/review?#{%{file_id: version.id}}"}
              id={"movie-correct-#{version.id}"}
              class="min-h-11 rounded-xl border border-border-strong px-4 py-3 text-sm text-ink transition hover:border-accent hover:text-accent-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >Corregir</.link>
          </div>
        </div>
        <p :if={@detail.versions == []} id="movie-no-versions" class="mt-4 text-sm text-muted">
          No hay versiones vinculadas.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
