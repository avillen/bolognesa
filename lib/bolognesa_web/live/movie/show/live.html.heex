<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section id="movie-detail" class="movie-screen mx-auto max-w-5xl">
    <.link
      navigate={~p"/movies?#{@library_params}"}
      class="media-back-link mb-3"
    >{gettext("← Todas las películas")}</.link>
    <p :if={@loading?} id="movie-loading" role="status" class="text-muted">
      {gettext("Cargando ficha…")}
    </p>
    <p
      :if={@error}
      id="movie-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail}>
      <header class="movie-heading">
        <h1 id="movie-title" class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {@detail.movie.title}
        </h1>
        <p class="mt-1 text-xs text-muted">{@detail.movie.year || gettext("Año desconocido")}</p>
      </header>
      <BolognesaWeb.Player.player
        prefix="movie"
        kind={:movie}
        viewer_id={@current_scope.actor.id}
        class="movie-player space-y-3"
        poster={
          @detail.movie.backdrop_path &&
            "https://image.tmdb.org/t/p/w780#{@detail.movie.backdrop_path}"
        }
        retry_file_id={
          Enum.find_value(@detail.versions, &(&1.availability == :available && &1.id))
        }
        entry_id={elem(@content_ref, 1)}
        selected_file_id={@selected_file_id}
        transcode_session={@transcode_session}
        transcode_ready?={@transcode_ready?}
        transcode_paused?={@transcode_paused?}
        transcode_autoplay?={@transcode_autoplay?}
        playback_error={@playback_error}
        playback_error_reason={@playback_error_reason}
      />
      <section id="movie-synopsis" class="movie-synopsis">
        <h2 class="mb-3 text-base font-semibold text-ink">{gettext("Sinopsis")}</h2>
        <BolognesaWeb.MediaComponents.synopsis
          :if={@detail.movie.overview}
          id="movie-description"
          text={@detail.movie.overview}
        />
        <p :if={!@detail.movie.overview} class="text-sm text-muted">
          {gettext("Todavía no hay sinopsis.")}
        </p>
      </section>
      <details
        id="movie-playback-options"
        class="playback-options"
        phx-mounted={JS.ignore_attributes("open")}
      >
        <summary>{gettext("Opciones de reproducción")}</summary>
        <BolognesaWeb.Player.playback_mode
          selected_file_id={@selected_file_id}
          transcode_session={@transcode_session}
          playback_error={@playback_error}
        />
        <h2 class="movie-versions-heading text-xl font-semibold text-ink">
          {gettext("Versiones en tu biblioteca")}
        </h2>
        <div id="movie-versions" class="mt-4 space-y-3">
          <div
            :for={version <- @detail.versions}
            id={"movie-version-#{version.id}"}
            class="movie-version-card"
          >
            <div class="movie-version-summary">
              <span class="movie-version-icon" aria-hidden="true"><.icon
                name="hero-film"
                class="size-6"
              /></span>
              <div class="min-w-0">
                <p class="font-semibold text-ink">{gettext("Versión")} {version.id}</p>
                <span
                  :if={version.id == @selected_file_id}
                  id={"movie-selected-#{version.id}"}
                  class="movie-selected"
                >{gettext("Seleccionada")}</span>
                <p class="mt-1 text-xs text-muted">
                  {if version.origin == :manual,
                    do: gettext("Identificación manual"),
                    else: gettext("Identificación automática")}{if version.needs_review,
                    do: gettext(" · Revisar"),
                    else: ""}
                </p>
              </div>
            </div>
            <span class={[
              "movie-version-availability",
              version.availability == :available && "is-available"
            ]}>{if version.availability ==
                     :available,
                   do: gettext("Disponible"),
                   else: gettext("No disponible")}</span>
            <div class="movie-version-actions">
              <button
                :if={version.availability == :available}
                id={"movie-play-#{version.id}"}
                type="button"
                phx-click="play"
                phx-value-file_id={version.id}
                class="media-primary-action"
              >
                {gettext("Reproducir")}
              </button>
              <.link
                navigate={~p"/movies/review?#{%{file_id: version.id}}"}
                id={"movie-correct-#{version.id}"}
                class="media-secondary-action"
              >{gettext("Corregir")}</.link>
            </div>
          </div>
        </div>
        <p :if={@detail.versions == []} id="movie-no-versions" class="mt-4 text-sm text-muted">
          {gettext("No hay versiones vinculadas.")}
        </p>
      </details>
    </div>
  </section>
</Layouts.app>
