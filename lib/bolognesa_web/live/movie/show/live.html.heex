<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section id="movie-detail" class="mx-auto max-w-6xl space-y-6">
    <.link
      navigate={~p"/movies?#{@library_params}"}
      class="media-back-link"
    >{gettext("← Todas las películas")}</.link>
    <p :if={@loading?} id="movie-loading" role="status" class="text-muted">
      {gettext("Cargando ficha…")}
    </p>
    <p
      :if={@error}
      id="movie-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-5 text-red-100"
    >
      {@error}
    </p>
    <div :if={@detail} class="media-detail-panel">
      <div class="media-hero">
        <div
          :if={@detail.movie.backdrop_path}
          class="media-backdrop"
        >
          <img
            id={"movie-backdrop-#{@detail.movie.id}"}
            phx-hook="ImageFallback"
            phx-update="ignore"
            src={"https://image.tmdb.org/t/p/w780#{@detail.movie.backdrop_path}"}
            alt={gettext("Imagen de %{value0}", value0: @detail.movie.title)}
            class="size-full object-cover"
          />
        </div>
        <div class="media-hero-content">
          <div class="media-hero-poster">
            <div class="media-art-fallback" aria-hidden="true">
              <.icon name="hero-film" class="size-10" />
            </div>
            <img
              :if={@detail.movie.poster_path}
              id={"movie-detail-poster-#{@detail.movie.id}"}
              phx-hook="ImageFallback"
              phx-update="ignore"
              src={"https://image.tmdb.org/t/p/w342#{@detail.movie.poster_path}"}
              alt={gettext("Cartel de %{value0}", value0: @detail.movie.title)}
              class="absolute inset-0 size-full object-cover"
            />
          </div>
          <div class="media-hero-copy">
            <p class="media-eyebrow">
              {gettext("Ficha de película")}
            </p>
            <h1 id="movie-title" class="text-4xl font-semibold text-ink">
              {@detail.movie.title}
            </h1>
            <p class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted">
              <span>{@detail.movie.year || gettext("Año desconocido")}</span>
              <span aria-hidden="true" class="text-accent">/</span>
              <span>{ngettext("%{count} versión", "%{count} versiones", length(@detail.versions))}</span>
            </p>
            <p :if={@detail.movie.overview} class="media-synopsis">
              {@detail.movie.overview}
            </p>
            <p :if={!@detail.movie.overview} class="media-synopsis">
              {gettext("Todavía no hay sinopsis.")}
            </p>
          </div>
        </div>
      </div>
      <div class="movie-detail-body">
        <BolognesaWeb.Player.player
          prefix="movie"
          kind={:movie}
          entry_id={elem(@content_ref, 1)}
          selected_file_id={@selected_file_id}
          compatible_session={@compatible_session}
          compatible_ready?={@compatible_ready?}
          compatible_paused?={@compatible_paused?}
          compatible_autoplay?={@compatible_autoplay?}
          playback_error={@playback_error}
          playback_error_reason={@playback_error_reason}
        />
        <h2 class="movie-versions-heading text-xl font-semibold text-ink">
          {gettext("Versiones en tu biblioteca")}
        </h2>
        <div id="movie-versions" phx-update="stream" class="mt-4 space-y-3">
          <div
            :for={{dom_id, version} <- @streams.versions}
            id={dom_id}
            class="movie-version-card"
          >
            <div class="movie-version-summary">
              <span class="movie-version-icon" aria-hidden="true"><.icon
                name="hero-film"
                class="size-6"
              /></span>
              <div class="min-w-0">
                <p class="font-semibold text-ink">{gettext("Versión")} {version.id}</p>
                <p class="mt-1 text-xs text-muted">
                  {if version.origin == :manual,
                    do: gettext("Identificación manual"),
                    else: gettext("Identificación automática")}{if version.needs_review,
                    do: gettext(" · Revisar"),
                    else: ""}
                </p>
              </div>
            </div>
            <span class={[
              "movie-version-availability",
              version.availability == :available && "is-available"
            ]}>{if version.availability ==
                     :available,
                   do: gettext("Disponible"),
                   else: gettext("No disponible")}</span>
            <div class="movie-version-actions">
              <button
                :if={version.availability == :available}
                id={"movie-play-#{version.id}"}
                type="button"
                phx-click="play"
                phx-value-file_id={version.id}
                class="media-primary-action"
              >
                {gettext("Reproducir")}
              </button>
              <.link
                navigate={~p"/movies/review?#{%{file_id: version.id}}"}
                id={"movie-correct-#{version.id}"}
                class="media-secondary-action"
              >{gettext("Corregir")}</.link>
            </div>
          </div>
        </div>
        <p :if={@detail.versions == []} id="movie-no-versions" class="mt-4 text-sm text-muted">
          {gettext("No hay versiones vinculadas.")}
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
