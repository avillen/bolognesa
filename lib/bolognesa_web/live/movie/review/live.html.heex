<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section id="movie-review" class="mx-auto max-w-6xl space-y-8">
    <header>
      <.link
        navigate={~p"/movies"}
        class="inline-flex min-h-11 items-center text-sm font-medium text-accent-soft hover:text-accent-soft"
      >{gettext("← Películas")}</.link>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
        {gettext("Revisar identificaciones")}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
        {gettext(
          "Elige otra película, marca el archivo sin identificar o vuelve a solicitar la búsqueda automática."
        )}
      </p>
    </header>
    <p
      :if={@feedback}
      id="review-feedback"
      role="status"
      class="rounded-xl border border-accent/30 bg-accent/10 p-4 text-sm text-accent-soft"
    >
      {@feedback}
    </p>
    <p :if={@loading?} id="review-loading" role="status" class="text-sm text-muted">
      {gettext("Cargando archivos…")}
    </p>
    <p :if={@saving?} id="correction-saving" role="status" class="text-sm text-muted">
      {gettext("Guardando corrección…")}
    </p>
    <p
      :if={@error}
      id="review-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-4 text-red-100"
    >
      {@error}
    </p>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]">
      <div id="review-list" phx-update="stream" class="space-y-3">
        <ReviewItem.item
          :for={{dom_id, item} <- @streams.reviews}
          dom_id={dom_id}
          item={item}
        />
      </div>
      <CorrectionPanel.panel
        form={@form}
        selected_file_id={@selected_file_id}
        searching?={@searching?}
        saving?={@saving?}
        candidates={@candidates}
      />
    </div>
    <p
      :if={!@loading? && @total == 0}
      id="review-empty"
      class="rounded-2xl border border-dashed border-border p-8 text-center text-muted"
    >
      {gettext("No hay archivos que revisar.")}
    </p>
    <nav
      :if={@total > 24}
      id="review-pagination"
      aria-label={gettext("Páginas de revisión")}
      class="flex items-center justify-center gap-4"
    >
      <.link
        :if={@page > 1}
        patch={~p"/movies/review?#{%{page: @page - 1}}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Anterior")}</.link>
      <span class="text-sm text-muted">{gettext("Página %{page}", page: @page)}</span>
      <.link
        :if={@page * 24 < @total}
        patch={~p"/movies/review?#{%{page: @page + 1}}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
