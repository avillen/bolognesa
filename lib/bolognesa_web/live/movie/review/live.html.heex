<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section id="movie-review" class="mx-auto max-w-6xl space-y-8">
    <header>
      <.link
        navigate={~p"/movies"}
        class="inline-flex min-h-11 items-center text-sm font-medium text-accent-soft hover:text-accent-soft"
      >{gettext("← Películas")}</.link>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink">
        {gettext("Revisar identificaciones")}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
        {gettext(
          "Elige otra película, marca el archivo sin identificar o vuelve a solicitar la búsqueda automática."
        )}
      </p>
    </header>
    <p
      :if={@feedback}
      id="review-feedback"
      role="status"
      class="rounded-xl border border-accent/30 bg-accent/10 p-4 text-sm text-accent-soft"
    >
      {@feedback}
    </p>
    <p :if={@loading?} id="review-loading" role="status" class="text-sm text-muted">
      {gettext("Cargando archivos…")}
    </p>
    <p :if={@saving?} id="correction-saving" role="status" class="text-sm text-muted">
      {gettext("Guardando corrección…")}
    </p>
    <p
      :if={@error}
      id="review-error"
      role="alert"
      class="rounded-xl border border-red-300/30 p-4 text-red-100"
    >
      {@error}
    </p>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)]">
      <div id="review-list" phx-update="stream" class="space-y-3">
        <article
          :for={{dom_id, item} <- @streams.reviews}
          id={dom_id}
          class="rounded-2xl border border-border bg-surface p-5"
        >
          <h2 class="break-words font-semibold text-ink">{item.filename}</h2>
          <p class="mt-2 text-xs text-muted">
            {state_label(item.state)} · {if item.availability == :available,
              do: gettext("Disponible"),
              else: gettext("Ausente")}
          </p>
          <p :if={item.movie_title} class="mt-2 text-sm text-accent-soft">{item.movie_title}</p>
          <p
            :if={item.failure_reason}
            id={"review-failure-#{item.file_id}"}
            class="mt-2 text-sm text-red-200"
          >
            {failure_label(item.failure_reason)}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <button
              id={"review-select-#{item.file_id}"}
              type="button"
              phx-click="select"
              phx-value-file_id={item.file_id}
              class="min-h-11 rounded-xl bg-accent px-4 text-sm font-semibold text-canvas transition hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >{gettext("Corregir")}</button>
            <button
              :if={item.state != :manual_unidentified}
              id={"review-retry-#{item.file_id}"}
              type="button"
              phx-click="retry"
              phx-value-file_id={item.file_id}
              class="min-h-11 rounded-xl border border-border-strong px-4 text-sm text-ink transition hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >{gettext("Reintentar")}</button>
          </div>
        </article>
      </div>
      <div class="rounded-2xl border border-border bg-surface p-5 sm:p-7">
        <h2 class="text-xl font-semibold text-ink">{gettext("Corrección manual")}</h2>
        <p class="mt-2 text-sm text-muted">
          {if @selected_file_id,
            do: gettext("Archivo seleccionado: %{value0}", value0: @selected_file_id),
            else: gettext("Selecciona un archivo de la lista.")}
        </p>
        <.form for={@form} id="correction-form" phx-submit="search" class="mt-5 space-y-4">
          <.input
            field={@form[:query]}
            id="correction-query"
            type="search"
            label={gettext("Buscar en TMDb")}
            class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none focus:border-accent"
          />
          <button
            id="correction-search"
            type="submit"
            disabled={is_nil(@selected_file_id) || @searching?}
            class="min-h-11 w-full rounded-xl border border-accent/50 px-4 font-semibold text-accent-soft transition hover:bg-accent/10 disabled:opacity-50"
          >{if @searching?, do: gettext("Buscando…"), else: gettext("Buscar")}</button>
        </.form>
        <div id="correction-candidates" class="mt-5 space-y-2">
          <button
            :for={candidate <- @candidates}
            id={"candidate-#{candidate.provider_id}"}
            type="button"
            phx-click="choose_candidate"
            phx-value-tmdb_id={candidate.provider_id}
            class="min-h-11 w-full rounded-xl border border-border-strong p-3 text-left text-sm text-ink transition hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >{candidate.title} {candidate.year}</button>
        </div>
        <.form for={@form} id="correction-choice-form" phx-submit="correct" class="mt-5 space-y-3">
          <.input
            field={@form[:tmdb_id]}
            id="correction-tmdb-id"
            type="number"
            label={gettext("ID de TMDb")}
            min="1"
            class="w-full rounded-xl border border-border-strong bg-raised px-4 py-3 text-ink outline-none focus:border-accent"
          />
          <button
            id="correction-submit"
            type="submit"
            disabled={is_nil(@selected_file_id) || @saving?}
            phx-disable-with={gettext("Guardando…")}
            class="min-h-11 w-full rounded-xl bg-accent px-4 font-semibold text-canvas transition hover:bg-accent-hover disabled:opacity-50"
          >{gettext("Confirmar película")}</button>
        </.form>
        <button
          id="correction-unidentified"
          type="button"
          phx-click="unidentified"
          disabled={is_nil(@selected_file_id) || @saving?}
          class="mt-3 min-h-11 w-full rounded-xl border border-border-strong px-4 text-sm text-ink transition hover:border-border-strong disabled:opacity-50"
        >{gettext("Dejar sin identificar")}</button>
      </div>
    </div>
    <p
      :if={!@loading? && @total == 0}
      id="review-empty"
      class="rounded-2xl border border-dashed border-border p-8 text-center text-muted"
    >
      {gettext("No hay archivos que revisar.")}
    </p>
    <nav
      :if={@total > 24}
      id="review-pagination"
      aria-label={gettext("Páginas de revisión")}
      class="flex items-center justify-center gap-4"
    >
      <.link
        :if={@page > 1}
        patch={~p"/movies/review?#{%{page: @page - 1}}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Anterior")}</.link>
      <span class="text-sm text-muted">{gettext("Página %{page}", page: @page)}</span>
      <.link
        :if={@page * 24 < @total}
        patch={~p"/movies/review?#{%{page: @page + 1}}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
