<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section
    id="movies-screen"
    phx-hook="BrowsePosition"
    data-loading={to_string(@loading?)}
    class="media-catalog mx-auto max-w-6xl space-y-8"
  >
    <MediaComponents.catalog_header
      title={@library_name || gettext("Películas")}
      form={@form}
      search_id="movie-search-form"
      search_label={gettext("Buscar película")}
      options_id="movies-library-options"
    >
      <.link id="movies-review-link" navigate={~p"/movies/review"} class="app-nav-link">
        {gettext("Revisar identificaciones")}
      </.link>
    </MediaComponents.catalog_header>
    <section
      :if={@recent_movies != [] && @query == ""}
      id="movies-recent-shelf"
      aria-labelledby="movies-recent-shelf-title"
    >
      <h2 id="movies-recent-shelf-title" class="sr-only">{gettext("Vistas recientemente")}</h2>
      <div class="media-shelf">
        <MediaComponents.shelf_tile
          :for={{movie, index} <- Enum.with_index(@recent_movies)}
          id={"recent-movie-#{movie.id}"}
          title={movie.title}
          navigate={~p"/movies/#{movie.id}?#{@library_params}"}
          art={movie.backdrop_path || movie.poster_path}
          icon="hero-film"
          overview={movie.overview}
          lead?={index == 0}
        >
          <:action :let={class}>
            <.link
              id={"recent-movie-open-#{movie.id}"}
              navigate={~p"/movies/#{movie.id}?#{@library_params}"}
              class={class}
            >
              <.icon name="hero-information-circle" class="size-5" />
              {gettext("Ver ficha")}
            </.link>
          </:action>
        </MediaComponents.shelf_tile>
      </div>
    </section>
    <p :if={@loading?} id="movies-loading" role="status" class="text-muted">
      {gettext("Cargando películas…")}
    </p>
    <MediaComponents.retry_alert
      :if={@error}
      id="movies-error"
      patch={~p"/movies?#{Map.merge(@library_params, %{query: @query, page: @page})}"}
    >
      {@error}
    </MediaComponents.retry_alert>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="movies-empty"
      class="rounded-xl border border-dashed border-border p-6 text-muted"
    >
      <span :if={@query == ""}>{gettext(
        "No hay películas en esta biblioteca. Escanea una biblioteca de películas o revisa las identificaciones."
      )}</span>
      <span :if={@query != ""}>{gettext("No hay películas que coincidan con tu búsqueda.")}</span>
      <.link
        :if={@query != ""}
        id="movies-clear-search"
        patch={~p"/movies?#{@library_params}"}
        class="mt-3 block min-h-11 py-3 text-accent-soft"
      >{gettext("Limpiar búsqueda")}</.link>
    </p>
    <p
      :if={!@loading? && !@error && @total > 0}
      id="movies-count"
      class="media-result-count media-catalog-count"
    >
      {ngettext("%{count} película", "%{count} películas", @total)}
    </p>
    <div id="movies-list" phx-update="stream" class="media-poster-grid">
      <MovieCard.card
        :for={{dom_id, movie} <- @streams.movies}
        dom_id={dom_id}
        movie={movie}
        library_params={@library_params}
      />
    </div>
    <MediaComponents.pagination
      id="movies"
      label={gettext("Páginas del catálogo")}
      page={@page}
      page_size={@page_size}
      total={@total}
      path={fn page -> ~p"/movies?#{Map.merge(@library_params, %{query: @query, page: page})}" end}
    />
  </section>
</Layouts.app>
