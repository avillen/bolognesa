<Layouts.app
  navigation_libraries={@navigation_libraries}
  navigation_error={@navigation_error}
  active_library_id={@active_library_id}
  flash={@flash}
  current_scope={@current_scope}
  active_section={:movies}
>
  <section id="movies-screen" class="mx-auto max-w-6xl space-y-8">
    <header class="media-catalog-heading">
      <div>
        <p class="media-eyebrow">{gettext("Tu biblioteca")}</p>
        <h1 class="mt-3 text-4xl font-semibold text-ink">
          {@library_name || gettext("Películas")}
        </h1>
      </div>
      <.link navigate={~p"/movies/review"} id="movies-review-link" class="media-secondary-action">
        <.icon name="hero-adjustments-horizontal" class="size-4" />
        {gettext("Revisar identificaciones")}
      </.link>
    </header>
    <div class="media-toolbar">
      <.form for={@form} id="movie-search-form" phx-submit="search" class="media-search-form">
        <div class="media-search-field">
          <.icon name="hero-magnifying-glass" class="size-5 text-muted" />
          <.input
            field={@form[:query]}
            id="movie-search-query"
            type="search"
            label={gettext("Buscar película")}
            placeholder={gettext("Buscar por título…")}
            class="media-search-input"
          />
        </div>
        <button id="movie-search-button" type="submit" class="media-primary-action">{gettext(
          "Buscar"
        )}</button>
      </.form>
      <p :if={!@loading? && !@error} id="movies-count" class="media-result-count">
        {ngettext("%{count} película", "%{count} películas", @total)}
      </p>
    </div>

    <p :if={@loading?} id="movies-loading" role="status" class="text-sm text-muted">
      {gettext("Cargando películas…")}
    </p>
    <p
      :if={@error}
      id="movies-error"
      role="alert"
      class="rounded-xl border border-red-300/30 bg-red-300/10 p-4 text-red-100"
    >
      {@error}
    </p>
    <div id="movies-list" phx-update="stream" class="media-poster-grid">
      <div
        :for={{dom_id, movie} <- @streams.movies}
        id={dom_id}
        class="poster-card"
      >
        <.link
          navigate={~p"/movies/#{movie.id}?#{@library_params}"}
          id={"movie-link-#{movie.id}"}
          class="media-catalog-link"
        >
          <div class="poster-art media-poster-art">
            <div class="media-art-fallback" aria-hidden="true">
              <.icon name="hero-film" class="size-9" />
              <span>{movie.title}</span>
            </div>
            <img
              :if={movie.poster_path}
              id={"movie-poster-#{movie.id}"}
              phx-hook="ImageFallback"
              phx-update="ignore"
              src={"https://image.tmdb.org/t/p/w500#{movie.poster_path}"}
              alt={gettext("Cartel de %{value0}", value0: movie.title)}
              loading="lazy"
              class="absolute inset-0 size-full object-cover"
            />
            <span class="media-year">{movie.year || gettext("Año desconocido")}</span>
          </div>
          <div class="pt-4">
            <h2 class="text-base font-semibold leading-snug text-ink">{movie.title}</h2>
            <p class="mt-1 text-xs text-muted">
              {ngettext(
                "%{count} versión",
                "%{count} versiones",
                movie.version_count
              )}
            </p>
            <p class="mt-1 text-xs font-medium text-muted">
              {ngettext("%{count} disponible", "%{count} disponibles", movie.available_count)}
            </p>
          </div>
        </.link>
      </div>
    </div>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="movies-empty"
      class="rounded-2xl border border-dashed border-border p-8 text-center text-muted"
    >
      {gettext(
        "Aún no hay películas con ese nombre. Escanea una biblioteca o revisa las identificaciones."
      )}
    </p>
    <nav
      :if={@total > 24}
      id="movies-pagination"
      aria-label={gettext("Páginas del catálogo")}
      class="media-pagination items-center"
    >
      <.link
        :if={@page > 1}
        patch={~p"/movies?#{Map.merge(@library_params, %{query: @query, page: @page - 1})}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Anterior")}</.link>
      <span class="text-sm text-muted">{gettext("Página %{page}", page: @page)}</span>
      <.link
        :if={@page * 24 < @total}
        patch={~p"/movies?#{Map.merge(@library_params, %{query: @query, page: @page + 1})}"}
        class="rounded-xl border border-border-strong px-4 py-3 text-ink"
      >{gettext("Siguiente")}</.link>
    </nav>
  </section>
</Layouts.app>
