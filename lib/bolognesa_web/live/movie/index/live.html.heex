<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="movies-screen" class="mx-auto max-w-6xl space-y-8">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-300">Colección</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-stone-50">Películas</h1>
        <p class="mt-3 text-sm text-stone-400">Obras identificadas de tus bibliotecas.</p>
      </div>
      <.link
        navigate={~p"/movies/review"}
        id="movies-review-link"
        class="min-h-11 rounded-xl border border-amber-300/50 px-5 py-3 text-sm font-semibold text-amber-200 transition hover:bg-amber-300/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
      >Revisar identificaciones</.link>
    </header>

    <.form
      for={@form}
      id="movie-search-form"
      phx-submit="search"
      class="flex flex-col gap-3 sm:flex-row"
    >
      <.input
        field={@form[:q]}
        id="movie-search-query"
        type="search"
        label="Buscar película"
        class="w-full rounded-xl border border-stone-600 bg-zinc-900 px-4 py-3 text-stone-50 outline-none focus:border-amber-300"
      />
      <button
        id="movie-search-button"
        type="submit"
        class="min-h-12 rounded-xl bg-amber-300 px-6 font-semibold text-stone-950 transition hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
      >Buscar</button>
    </.form>

    <p :if={@loading?} id="movies-loading" role="status" class="text-sm text-stone-300">
      Cargando películas…
    </p>
    <p
      :if={@error}
      id="movies-error"
      role="alert"
      class="rounded-xl border border-red-300/30 bg-red-300/10 p-4 text-red-100"
    >
      {@error}
    </p>
    <p :if={!@loading? && !@error} id="movies-count" class="text-sm text-stone-400">
      {@total} películas
    </p>

    <div id="movies-list" phx-update="stream" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <div
        :for={{dom_id, movie} <- @streams.movies}
        id={dom_id}
        class="group overflow-hidden rounded-2xl border border-stone-700 bg-zinc-900 transition hover:border-amber-300/50 hover:shadow-xl"
      >
        <.link
          navigate={~p"/movies/#{movie.id}"}
          id={"movie-link-#{movie.id}"}
          class="block h-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
        >
          <div class="flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-stone-800 to-stone-950 text-4xl font-bold text-amber-200/50">
            {String.first(movie.title)}
          </div>
          <div class="p-5">
            <h2 class="text-lg font-semibold text-stone-50">{movie.title}</h2>
            <p class="mt-2 text-sm text-stone-400">
              {movie.year || "Año desconocido"} · {movie.version_count} versiones
            </p>
            <p class="mt-3 text-xs font-medium text-amber-200">
              {movie.available_count} disponibles
            </p>
          </div>
        </.link>
      </div>
    </div>
    <p
      :if={!@loading? && !@error && @total == 0}
      id="movies-empty"
      class="rounded-2xl border border-dashed border-stone-700 p-8 text-center text-stone-400"
    >
      Aún no hay películas con ese nombre. Escanea una biblioteca o revisa las identificaciones.
    </p>
    <nav
      :if={@total > 24}
      id="movies-pagination"
      aria-label="Páginas del catálogo"
      class="flex items-center justify-center gap-4"
    >
      <.link
        :if={@page > 1}
        patch={~p"/movies?#{%{q: @query, page: @page - 1}}"}
        class="rounded-xl border border-stone-600 px-4 py-3 text-stone-200"
      >Anterior</.link>
      <span class="text-sm text-stone-400">Página {@page}</span>
      <.link
        :if={@page * 24 < @total}
        patch={~p"/movies?#{%{q: @query, page: @page + 1}}"}
        class="rounded-xl border border-stone-600 px-4 py-3 text-stone-200"
      >Siguiente</.link>
    </nav>
  </section>
</Layouts.app>
