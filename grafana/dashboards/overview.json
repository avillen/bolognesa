    {
      "id": 11,
      "type": "row",
      "title": "Docker \u00b7 optional Linux collector",
      "collapsed": true,
      "panels": [
        {
          "id": 12,
          "type": "stat",
          "title": "Docker collector scrape",
          "description": "Requires monitoring.docker.yaml on native Linux. No data means absent or unavailable collection, not zero resource use. The exporter may be up even when container discovery fails.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 0,
            "y": 14,
            "w": 8,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "none",
            "graphMode": "none",
            "textMode": "auto",
            "orientation": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "refId": "Q0",
              "expr": "up{job=\"bolognesa-docker\", instance=\"$instance\"}",
              "legendFormat": "Scrape",
              "editorMode": "code",
              "instant": true,
              "range": false
            }
          ]
        },
        {
          "id": 13,
          "type": "stat",
          "title": "Containers observed recently",
          "description": "At least one fresh container sample per service. Missing service requires investigation; scrape success alone is insufficient.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 8,
            "y": 14,
            "w": 8,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "none",
            "graphMode": "none",
            "textMode": "auto",
            "orientation": "auto",
            "justifyMode": "auto"
          },
          "targets": [
            {
              "refId": "Q0",
              "expr": "count by (service) (container_last_seen{job=\"bolognesa-docker\", instance=\"$instance\"} > time() - 180)",
              "legendFormat": "{{service}}",
              "editorMode": "code",
              "instant": true,
              "range": false
            }
          ]
        },
        {
          "id": 14,
          "type": "timeseries",
          "title": "CPU \u00b7 cores used",
          "description": "One unit is one CPU core. Includes FFmpeg subprocesses in the app container.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 16,
            "y": 14,
            "w": 8,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
