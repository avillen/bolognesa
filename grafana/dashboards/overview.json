              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "Q0",
              "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{job=\"bolognesa-docker\", instance=\"$instance\"}[$__rate_interval]))",
              "legendFormat": "{{service}}",
              "editorMode": "code",
              "instant": false,
              "range": true
            }
          ]
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Memory \u00b7 usage vs limit",
          "description": "Working set is current usage summed by service; the dashed line is the configured container limit. Unlimited containers can report the host limit. Limits are per container, so replicas would make the sum and max incomparable.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 0,
            "y": 18,
            "w": 12,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 8,
                "showPoints": "auto",
                "spanNulls": false
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byRegexp",
                  "options": ".* \u00b7 limit"
                },
                "properties": [
                  {
                    "id": "custom.lineStyle",
                    "value": {
                      "fill": "dash",
                      "dash": [
                        10,
                        10
                      ]
                    }
                  },
                  {
                    "id": "custom.fillOpacity",
                    "value": 0
                  },
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#8a8a8a"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "Q0",
              "expr": "sum by (service) (container_memory_working_set_bytes{job=\"bolognesa-docker\", instance=\"$instance\"})",
              "legendFormat": "{{service}} \u00b7 usage",
              "editorMode": "code",
              "instant": false,
              "range": true
            },
            {
              "refId": "Q1",
              "expr": "max by (service) (container_spec_memory_limit_bytes{job=\"bolognesa-docker\", instance=\"$instance\"})",
              "legendFormat": "{{service}} \u00b7 limit",
              "editorMode": "code",
              "instant": false,
              "range": true
            }
          ]
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "Network \u00b7 receive / transmit",
          "description": "Per-container network counters. Host-network containers can share host counters; values must not be summed into a host total.",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "gridPos": {
            "x": 12,
            "y": 18,
            "w": 12,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "Bps",
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 1,
                "fillOpacity": 8,
                "showPoints": "auto",
                "spanNulls": false
