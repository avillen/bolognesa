              "placement": "bottom",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "refId": "Q0",
              "expr": "sum by (service) (rate(container_network_receive_bytes_total{job=\"bolognesa-docker\", instance=\"$instance\"}[$__rate_interval]))",
              "legendFormat": "{{service}} \u00b7 RX",
              "editorMode": "code",
              "instant": false,
              "range": true
            },
            {
