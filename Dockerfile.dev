FROM hexpm/elixir:1.20.3-erlang-28.3.3-debian-trixie-20260824-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git curl ffmpeg inotify-tools socat ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app
